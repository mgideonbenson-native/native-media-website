# Copy to .env for local use. NEVER commit the real .env file.
# PUBLIC_FORM_ENDPOINT: web address of your form service (e.g. Formspree). Leave empty and forms show "not connected".
# NEWSLETTER_API_KEY=
# CONTACT_FORM_ENDPOINT=
# SANITY_PROJECT_ID=
PUBLIC_FORM_ENDPOINT=
# PUBLIC_BUTTONDOWN_USERNAME: your Buttondown username (the last part of buttondown.com/yourname). Turns on newsletter sign-up.
PUBLIC_BUTTONDOWN_USERNAME=
PUBLIC_NEWSLETTER_ENDPOINT=
PUBLIC_UNSUBSCRIBE_ENDPOINT=

# --- CMS (Sanity). Leave empty to keep using the local files in src/content. ---
# Website (build time):
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Only needed if your dataset is set to private:
SANITY_READ_TOKEN=
# Studio (editing screen) goes in studio/.env:
#   SANITY_STUDIO_PROJECT_ID=
#   SANITY_STUDIO_DATASET=production

# Set to true on preview/staging builds so search engines ignore every page (Netlify does this automatically via netlify.toml).
# PUBLIC_NOINDEX=true
