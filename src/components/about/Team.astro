---
import Visual from '../Visual.astro';
const slots = [1, 2, 3];
---
<section class="section theme-dark">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow">Leadership &amp; team</p><h2>The people behind Native Media.</h2>
      <p class="lede">Profiles will show each person’s name, official title, approved biography, photograph, expertise and public professional links. Nothing is published until it is supplied and approved.</p></div>
    <ul class="team">
      {slots.map(() => (
        <li>
          <Visual art="lens" label="Photo placeholder" ratio="4 / 5" />
          <h3>Name to be confirmed</h3>
          <p class="muted">Official title</p>
          <p class="muted small">Approved biography and areas of expertise will appear here.</p>
          <span class="tag">Placeholder profile</span>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .team { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .team li { display: grid; gap: 0.4rem; align-content: start; justify-items: start; }
  .team :global(.visual) { width: 100%; margin-bottom: 0.7rem; }
  .team h3 { font-size: var(--step-1); font-weight: 800; }
  .small { font-size: 0.88rem; }
</style>
