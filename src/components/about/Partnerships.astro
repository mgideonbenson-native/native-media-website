---
const kinds = [
  ['Confirmed partners', 'Formally established institutional, commercial, academic or production partners.'],
  ['Project collaborators', 'Organizations working with Native Media on a specific project.'],
  ['Sponsors', 'Paid sponsors, always labelled as such. Sponsorship never determines editorial content.'],
  ['Clients', 'Organizations for which Native Media has produced work, listed only with permission.'],
  ['Contributors', 'Individuals and organizations who contribute material or expertise.'],
  ['Prospective relationships', 'Proposed engagements. These are never presented as partnerships.'],
];
---
<section class="section theme-light">
  <div class="wrap">
    <div class="section-head"><p class="eyebrow">Partnerships</p><h2>Only confirmed relationships, clearly described.</h2>
      <p class="lede">Native Media distinguishes between types of relationship and never implies endorsement, government affiliation or institutional approval without authorization.</p></div>
    <ul class="cards">
      {kinds.map(([t, d]) => (
        <li class="card"><h3>{t}</h3><p>{d}</p></li>
      ))}
    </ul>
  </div>
</section>
<style>.card .tag { justify-self: start; margin-top: 0.4rem; }</style>
