---
/**
 * Privacy-friendly visitor statistics (Plausible). Cookie-free, no personal data, no cross-site tracking.
 * Loads only when PUBLIC_PLAUSIBLE_DOMAIN is set, and never on preview builds (PUBLIC_NOINDEX).
 * Self-hosting? Set PUBLIC_PLAUSIBLE_SRC to your own script address.
 */
const domain = import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN as string | undefined;
const src = (import.meta.env.PUBLIC_PLAUSIBLE_SRC as string | undefined) || 'https://plausible.io/js/script.js';
const preview = import.meta.env.PUBLIC_NOINDEX === 'true';
---
{domain && !preview && <script is:inline defer data-domain={domain} src={src}></script>}
