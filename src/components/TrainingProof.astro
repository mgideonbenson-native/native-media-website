---
import { Image } from 'astro:assets';
import classroom from '../assets/training/udsm-classroom.jpg';
import trainer from '../assets/training/udsm-trainer.jpg';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const photos = [
  { src: classroom, alt: 'A trainer at the whiteboard presenting slides to students seated at desks in a classroom at the University of Dar es Salaam School of PR & Advertising', pos: '50% 40%' },
  { src: trainer, alt: 'A trainer gesturing as he explains a slide to his class', pos: '55% 35%' },
];
---
<div class:list={['tp', { 'tp--compact': compact }]}>
  <div class="tp__stat reveal">
    <p class="tp__n"><strong>12</strong></p>
    <p class="tp__l">trainees trained so far</p>
    <p class="tp__t">Training sessions at the University of Dar es Salaam School of PR &amp; Advertising, where Native Media delivers a multi-week PR masterclass in partnership with the school.</p>
  </div>
  <ul class="tp__photos">
    {photos.map((p) => <li class="reveal"><Image src={p.src} alt={p.alt} widths={[480, 720, 960, 1280]} sizes="(min-width: 900px) 24rem, 92vw" loading="lazy" style={`object-position:${p.pos}`} /></li>)}
  </ul>
</div>
<style>
  .tp { display: grid; gap: 2rem; align-items: center; }
  .tp__stat { display: grid; gap: 0.5rem; align-content: start; }
  .tp__n { margin: 0; line-height: 0.9; } .tp__n strong { font-family: var(--font-display); font-weight: 800; font-size: clamp(5rem, 14vw, 9rem); letter-spacing: -0.05em; color: var(--brand); }
  :global(.theme-light) .tp__n strong { color: var(--brand-ink); }
  .tp__l { font-family: var(--font-display); font-weight: 800; font-size: var(--step-2); margin: 0; line-height: 1.1; }
  .tp__t { margin: 0.4rem 0 0; opacity: 0.8; max-width: 26rem; }
  .tp__photos { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.8rem; grid-template-columns: 1fr; }
  .tp__photos li { overflow: hidden; background: #111; }
  @media (min-width: 560px) { .tp__photos { grid-template-columns: 1fr 1fr; } }
  .tp__photos :global(img) { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; display: block; transition: transform 0.6s var(--ease); } .tp__photos li:hover :global(img) { transform: scale(1.03); }
  @media (min-width: 900px) { .tp { grid-template-columns: 0.8fr 1.2fr; gap: 4rem; } }
</style>
