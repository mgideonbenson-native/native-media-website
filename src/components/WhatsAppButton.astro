---
import { company } from '../data/site';
const href = `https://wa.me/${company.whatsapp}?text=${encodeURIComponent('Hello Native Media, I found you through your website and would like to talk.')}`;
---
{company.whatsapp && (
  <aside aria-label="Chat shortcut">
  <a class="wa" href={href} target="_blank" rel="noopener noreferrer" aria-label="Chat with Native Media on WhatsApp (opens in a new tab)">
    <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16.04 3C9.4 3 4 8.4 4 15.03c0 2.12.55 4.18 1.6 6L4 29l8.17-1.57a12.03 12.03 0 0 0 3.87.64C22.68 28.07 28 22.67 28 16.04 28 9.4 22.68 3 16.04 3Zm0 22.03c-1.2 0-2.37-.2-3.5-.6l-.5-.18-4.85.93.97-4.72-.2-.52A9.95 9.95 0 0 1 6 15.03C6 9.5 10.5 5 16.04 5 21.57 5 26 9.5 26 16.04c0 5.53-4.46 9-9.96 8.99Zm5.5-7.5c-.3-.15-1.78-.88-2.06-.98-.28-.1-.48-.15-.68.15-.2.3-.78.98-.95 1.18-.18.2-.35.22-.65.07-.3-.15-1.27-.47-2.42-1.5-.9-.8-1.5-1.78-1.67-2.08-.18-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.68-1.64-.93-2.25-.24-.58-.5-.5-.68-.5l-.58-.01c-.2 0-.52.08-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.5.7.3 1.26.5 1.7.62.72.23 1.37.2 1.88.12.57-.08 1.78-.73 2.03-1.43.25-.7.25-1.3.18-1.43-.08-.13-.28-.2-.58-.35Z"/></svg>
    <span class="wa__label">Chat on WhatsApp</span>
  </a>
  </aside>
)}
<style>
  .wa { position: fixed; right: max(1rem, env(safe-area-inset-right)); bottom: max(1rem, env(safe-area-inset-bottom)); z-index: 90; display: inline-flex; align-items: center; gap: 0.6rem; min-height: 3.5rem; min-width: 3.5rem; justify-content: center; padding: 0 1rem; border-radius: 999px; background: #1a7f4b; color: #fff; text-decoration: none; font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; box-shadow: 0 8px 22px -8px rgba(0, 0, 0, 0.55); border: 2px solid #fff; transition: transform 0.25s var(--ease), background 0.25s var(--ease); }
  .wa:hover { background: #146a3d; transform: translateY(-2px); }
  .wa:focus-visible { outline: 3px solid var(--brand); outline-offset: 3px; }
  .wa__label { display: none; }
  @media (min-width: 700px) { .wa__label { display: inline; } }
  @media (prefers-reduced-motion: no-preference) { .wa { animation: wa-in 0.6s var(--ease) 1.5s both; } @keyframes wa-in { from { opacity: 0; transform: translateY(14px); } } }
  @media print { .wa { display: none; } }
</style>
