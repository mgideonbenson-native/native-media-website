---
/**
 * Official Native Media logo, used exactly as supplied (no redrawing).
 * tone="light" -> version for dark backgrounds (default); tone="dark" -> version for light backgrounds.
 * TODO(owner): replace the PNGs in public/brand/ with the official vector (SVG) when available.
 */
interface Props { tone?: 'light' | 'dark'; class?: string }
const { tone = 'light', class: className = '' } = Astro.props;
const src = tone === 'light' ? '/brand/native-media-logo-on-dark.png' : '/brand/native-media-logo-on-light.png';
---
<img class:list={['logo', className]} src={src} width="575" height="480" alt="Native Media" decoding="async" />
<style>
  .logo { height: 3.7rem; width: auto; display: block; }
</style>
