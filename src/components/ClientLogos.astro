---
import { Image } from 'astro:assets';
import { clients } from '../data/clients';
interface Props { theme?: 'light' | 'dark'; id?: string }
const { id = 'clients-title' } = Astro.props;
---
<section class="section theme-light clients" aria-labelledby={id}>
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Clients</p>
      <h2 id={id}>Organizations we work with.</h2>
    </div>
    <ul class="clients__grid">
      {clients.map((c) => (
        <li class:list={['clients__item', 'reveal', `clients__item--${c.plate}`]}>
          <Image src={c.logo} alt={c.name} height={80} loading="lazy" class="clients__logo" />
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .clients__grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); }
  .clients__item { display: grid; place-items: center; min-height: 6.5rem; padding: 1.2rem 1.4rem; border: 1px solid var(--line-light); background: #fff; }
  .clients__item--dark { background: #17171a; border-color: #17171a; }
  .clients :global(.clients__logo) { max-height: 3rem; max-width: 100%; width: auto; height: auto; object-fit: contain; }
  .clients__item:hover { border-color: var(--brand); }
  @media (min-width: 700px) { .clients__grid { grid-template-columns: repeat(4, 1fr); } }
  @media (min-width: 1100px) { .clients__grid { grid-template-columns: repeat(7, 1fr); } .clients__item { min-height: 7.5rem; padding: 1rem; } }
</style>
