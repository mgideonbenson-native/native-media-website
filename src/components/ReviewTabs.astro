---
import { REVIEW_BASE } from '../data/review';
const items = [
  ['Overview', REVIEW_BASE], ['Part One', `${REVIEW_BASE}/chapters`], ['Opportunity Atlas', `${REVIEW_BASE}/opportunity-atlas`], ['Partner profiles', `${REVIEW_BASE}/embassy-profiles`],
  ['Part Four: Directory', `${REVIEW_BASE}/directory-and-data`], ['Quarterly updates', `${REVIEW_BASE}/quarterly-updates`],
  ['Digital edition', `${REVIEW_BASE}/digital-edition`], ['Methodology', `${REVIEW_BASE}/methodology`],
  ['Sponsorship', `${REVIEW_BASE}/sponsorship`], ['Corrections', `${REVIEW_BASE}/corrections`],
];
const here = Astro.url.pathname.replace(/\/$/, '');
---
<nav class="rtabs" aria-label="Tanzania Economic Diplomacy Review sections">
  <div class="wrap"><ul>{items.map(([l, h]) => <li><a href={h} aria-current={here === h ? 'page' : undefined}>{l}</a></li>)}</ul></div>
</nav>
<style>
  .rtabs { background: var(--charcoal); border-bottom: 1px solid var(--line-dark); position: sticky; top: var(--header-h); z-index: 50; }
  .rtabs ul { display: flex; gap: 0.2rem; overflow-x: auto; scrollbar-width: thin; }
  .rtabs a { display: block; padding: 0.95rem 0.9rem; white-space: nowrap; text-decoration: none; font-family: var(--font-display); font-weight: 600; font-size: 0.82rem; letter-spacing: 0.05em; text-transform: uppercase; border-bottom: 3px solid transparent; color: var(--gray); }
  .rtabs a:hover { color: var(--paper); } .rtabs a[aria-current] { color: var(--brand); border-bottom-color: var(--brand); }
</style>
