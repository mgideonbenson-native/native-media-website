---
import { Image } from 'astro:assets';
import cover from '../assets/review/edition-01-draft-cover.webp';
import { reviewMeta } from '../data/review';
/** Draft cover of Edition 01, supplied by the owner. The artwork is an AI-generated illustration (as noted in the draft). */
interface Props { class?: string; caption?: boolean }
const { class: className = '', caption = true } = Astro.props;
---
<figure class:list={['cover', className]}>
  <Image src={cover} alt="Draft cover of the Tanzania Economic Diplomacy Review, Edition 01, 2026/27: a port at sunset with the Native Media logo and the four parts of the book" widths={[360, 540, 720]} sizes="(min-width: 900px) 24rem, 80vw" loading="eager" />
  {caption && <figcaption><span class="tag">Draft cover · {reviewMeta.edition.coverNote.replace('Draft cover: ', '')}</span></figcaption>}
</figure>
<style>
  .cover { margin: 0 auto; width: min(100%, 24rem); display: grid; gap: 1rem; justify-items: start; }
  .cover :global(img) { width: 100%; height: auto; display: block; box-shadow: 0 30px 60px rgba(10, 10, 10, 0.35), 14px 14px 0 var(--brand); }
  .cover figcaption { margin-top: 0.6rem; }
</style>
