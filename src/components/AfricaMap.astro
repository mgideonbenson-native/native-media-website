---
import '../styles/viz.css';
import { geoMercator, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import topo from 'world-atlas/countries-110m.json';
import { isSample, sampleIndex } from '../data/sample';

// ISO 3166-1 numeric codes of African countries present in the 110m dataset.
const AFRICA = new Set(['12','24','204','72','854','108','120','140','148','178','180','384','262','818','226','232','748','231','266','270','288','324','624','404','426','430','434','450','454','466','478','504','508','516','562','566','646','686','694','706','710','728','729','834','768','788','800','894','716','732']);
const fc = feature(topo as any, (topo as any).objects.countries) as any;
const africa = { type: 'FeatureCollection', features: fc.features.filter((f: any) => AFRICA.has(String(Number(f.id)))) } as any;
const W = 720, H = 760;
const projection = geoMercator().fitExtent([[8, 8], [W - 8, H - 8]], africa);
const path = geoPath(projection);
const countries = africa.features.map((f: any) => ({ id: String(Number(f.id)), name: f.properties.name as string, d: path(f) as string, v: sampleIndex(f.properties.name) }))
  .filter((c: any) => c.d).sort((a: any, b: any) => a.name.localeCompare(b.name));
const ramp = ['#fbe5d6', '#f5c6a5', '#ee9f6c', '#df7a3a', '#bf5a1f'];
const classes = ['0 to 19', '20 to 39', '40 to 59', '60 to 79', '80 to 99'];
---
<section class="exhibit" data-map aria-labelledby="map-title">
  {isSample && <div class="exhibit__banner" role="note"><span class="tag">Illustrative sample data</span><span>Shading shows an invented index, not a real statistic. It exists to test the map design.</span></div>}
  <h2 class="exhibit__title" id="map-title">Africa: sample country index</h2>
  <div class="filters"><label class="shade"><input type="checkbox" data-shade /> Preview sample shading (illustrative)</label></div>
  <div class="mapwrap">
    <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Map of Africa. Each country can be focused with the keyboard to read its name and sample value." data-svg>
      {countries.map((c: any) => (
        <path d={c.d} tabindex="0" role="img" aria-label={`${c.name}`} data-name={c.name} data-v={c.v} data-fill={ramp[Math.min(4, Math.floor(c.v / 20))]} class:list={['ctry', { tz: c.id === '834' }]} />
      ))}
    </svg>
    <div class="viz-tip" data-tip hidden></div>
  </div>
  <ul class="legend" data-legend hidden aria-label="Legend: sample index classes">{ramp.map((c, i) => <li><span style={`background:${c}`}></span>{classes[i]}</li>)}</ul>
  <p class="sel" role="status" aria-live="polite" data-sel>Select a country to see its details. Tanzania is outlined.</p>
  <dl class="exhibit__meta">
    <div><dt>Title</dt><dd>Africa: sample country index</dd></div><div><dt>Indicator</dt><dd>Illustrative index (0 to 99)</dd></div>
    <div><dt>Reporting period</dt><dd>Sample, no real period</dd></div><div><dt>Source</dt><dd>None. Illustrative sample. Boundaries: Natural Earth via world-atlas (public domain)</dd></div>
    <div><dt>Units</dt><dd>Index points (not currency)</dd></div><div><dt>Notes</dt><dd>Boundaries are simplified and do not express any position on disputed territories.</dd></div>
  </dl>
  <details><summary>View as a table</summary><div class="viz-tablewrap"><table class="viz-table"><caption>Sample country index (illustrative, not real data)</caption>
    <thead><tr><th scope="col">Country</th><th scope="col">Sample index</th></tr></thead>
    <tbody>{countries.map((c: any) => <tr><th scope="row">{c.name}</th><td class="num">{c.v}</td></tr>)}</tbody></table></div></details>
</section>
<style>
  .mapwrap { position: relative; max-width: 46rem; margin-inline: auto; width: 100%; }
  svg { width: 100%; height: auto; display: block; }
  .ctry { fill: #e4e3dd; stroke: var(--viz-surface); stroke-width: 1; cursor: pointer; transition: fill 0.25s; outline: none; }
  .ctry:hover, .ctry:focus-visible { stroke: var(--viz-ink); stroke-width: 2; }
  .ctry.tz { stroke: var(--viz-1); stroke-width: 2.5; }
  .ctry.is-sel { stroke: var(--viz-ink); stroke-width: 2.5; }
  .legend { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; justify-content: center; font-size: 0.82rem; color: var(--viz-ink-2); }
  .legend span { display: inline-block; width: 18px; height: 10px; margin-right: 0.4rem; border: 1px solid #d0cfc8; }
  .sel { text-align: center; font-weight: 600; min-height: 1.5em; }
  .shade { display: flex; align-items: center; gap: 0.6rem; font-size: 0.92rem; } .shade input { accent-color: var(--brand); width: 1.1rem; height: 1.1rem; }
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-map]');
  if (root) {
    const paths = [...root.querySelectorAll<SVGPathElement>('.ctry')];
    const tip = root.querySelector<HTMLElement>('[data-tip]')!; const wrap = root.querySelector<HTMLElement>('.mapwrap')!;
    const sel = root.querySelector<HTMLElement>('[data-sel]')!; const legend = root.querySelector<HTMLElement>('[data-legend]')!;
    const box = root.querySelector<HTMLInputElement>('[data-shade]')!;
    const text = (p: SVGPathElement) => box.checked ? `${p.dataset.name}: sample index ${p.dataset.v} (illustrative, not real)` : `${p.dataset.name}: no data loaded`;
    box.addEventListener('change', () => { paths.forEach((p) => { p.style.fill = box.checked ? p.dataset.fill! : ''; }); legend.hidden = !box.checked; });
    const show = (p: SVGPathElement, x: number, y: number) => {
      tip.replaceChildren(); const s = document.createElement('strong'); s.textContent = p.dataset.name!; const d = document.createElement('div'); d.className = 'viz-tip__lab';
      d.textContent = box.checked ? `Sample index ${p.dataset.v} (illustrative)` : 'No data loaded'; tip.append(s, d); tip.hidden = false;
      tip.style.left = `${Math.min(x + 12, wrap.clientWidth - tip.offsetWidth - 4)}px`; tip.style.top = `${Math.max(0, y - 10)}px`;
    };
    paths.forEach((p) => {
      p.addEventListener('pointermove', (e) => { const r = wrap.getBoundingClientRect(); show(p, e.clientX - r.left, e.clientY - r.top); });
      p.addEventListener('pointerleave', () => (tip.hidden = true));
      p.addEventListener('focus', () => { const b = p.getBoundingClientRect(), r = wrap.getBoundingClientRect(); show(p, b.left - r.left + b.width / 2, b.top - r.top); });
      p.addEventListener('blur', () => (tip.hidden = true));
      p.addEventListener('click', () => { paths.forEach((q) => q.classList.remove('is-sel')); p.classList.add('is-sel'); sel.textContent = text(p); });
      p.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); p.dispatchEvent(new Event('click')); } });
    });
  }
</script>
