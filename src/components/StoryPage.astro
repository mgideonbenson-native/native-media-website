---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DemoBanner from './DemoBanner.astro';
import Visual from './Visual.astro';
import Cover from './Cover.astro';
import StoryCard from './StoryCard.astro';
import ShareBar from './ShareBar.astro';
import CtaBand from './CtaBand.astro';
import type { CollectionEntry } from 'astro:content';
import { findSection, findSub, storyCategoryLabel, storyKinds, storyPath } from '../data/categories';
interface Props { s: CollectionEntry<'stories'> }
const { s } = Astro.props;
const d = s.data;
const { Content } = await render(s);
const section = findSection(d.section)!;
const sub = findSub(d.section, d.sub);
const catLabel = storyCategoryLabel(d);
const minutes = Math.max(1, Math.round((s.body ?? '').split(/\s+/).length / 200));
const related = (await getCollection('stories')).filter((r) => r.id !== s.id && r.data.section === d.section && r.data.sub === d.sub).slice(0, 3);
const more = (await getCollection('stories')).filter((r) => r.id !== s.id).slice(0, 3);
const path = storyPath(s);
const op = d.opportunity;
const isOpEd = d.section === 'thought-leadership';
const ap = d.authorProfile;
---
<BaseLayout title={`${d.title.length > 52 ? d.title.slice(0, 50).trimEnd() + '…' : d.title} | Native Media`} description={d.subtitle} noindex={d.demo}>
  <article class="story theme-light">
    <header class="story__head theme-dark">
      <div class="wrap">
        <nav aria-label="Breadcrumb" class="crumbs"><ol><li><a href="/">Home</a></li><li><a href="/african-intelligence">African Intelligence</a></li><li><a href="/african-intelligence/stories">Stories</a></li><li><a href={`/african-intelligence/stories/${section.slug}`}>{section.label}</a></li>{sub && <li><a href={`/african-intelligence/stories/${section.slug}/${sub.slug}`}>{sub.label}</a></li>}</ol></nav>
        <p class="kindline"><span class="eyebrow">{catLabel}</span><span class="tag tag--brand" title={storyKinds[d.kind].text}>{storyKinds[d.kind].label}</span></p>
        <h1>{d.title}</h1>
        <p class="lede">{d.subtitle}</p>
        <p class="byline">By {d.author} · {d.date ? d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : 'Sample date'} · {minutes} min read</p>
      </div>
    </header>
    {d.demo && <DemoBanner text="Demonstration story. A layout preview with no real reporting, facts or figures." />}
    <div class="wrap hero-img">{d.image
      ? <Visual ratio="16 / 8"><Cover cover={d.image} widths={[720, 1080, 1440]} sizes="(min-width: 1300px) 78rem, 92vw" loading="eager" /></Visual>
      : <Visual art={d.art} label={d.demo ? 'Featured image placeholder' : 'Image placeholder'} ratio="16 / 8" />}</div>
    <div class="wrap story__grid">
      <aside class="stack side">
        <div class="notice-box"><span class="tag">{storyKinds[d.kind].label}</span><p class="small">{storyKinds[d.kind].text}</p>{d.sponsor && <p class="small"><strong>Sponsor:</strong> {d.sponsor}</p>}</div>
        {op && (
          <div class="notice-box oppo"><span class="tag tag--brand">Opportunity details</span>
            <dl>
              {op.organization && <><dt>Offered by</dt><dd>{op.organization}</dd></>}
              {op.deadline && <><dt>Deadline</dt><dd>{op.deadline}</dd></>}
              {op.eligibility && <><dt>Who can apply</dt><dd>{op.eligibility}</dd></>}
              {op.location && <><dt>Where</dt><dd>{op.location}</dd></>}
            </dl>
            {op.applyUrl && <a class="btn" href={op.applyUrl} rel="noopener noreferrer" target="_blank">Official application page <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>}
            <p class="small">Always check the official source before you apply. Native Media lists opportunities for information and does not run them unless stated.</p>
          </div>
        )}
        <ShareBar title={d.title} path={path} />
      </aside>
      <div class="prose">
        <Content />
        {d.demo && (<>
        <figure class="slot"><Visual art="grid" label="Data graphic placeholder" ratio="16 / 9" />
          <figcaption>Data graphic slot. Every published chart will show its title, indicator, reporting period, source, units and notes.</figcaption></figure>
        <blockquote class="pull">A pull quote from the story will be set here to highlight a key line.</blockquote>
        <figure class="slot"><Visual art="lens" label="Video embed placeholder" ratio="16 / 9" /><figcaption>Video embed slot.</figcaption></figure>
        </>)}
        {(d.sources.length > 0 || d.demo) && <h2>Sources</h2>}
        {d.sources.length > 0
          ? <ul class="src">{d.sources.map((x) => <li>{x}</li>)}</ul>
          : d.demo ? <p class="muted small">A numbered list of sources will appear here for each real story.</p> : null}
        {isOpEd && (
          <aside class="author" aria-labelledby="author-h">
            <h2 id="author-h" class="sr-only">About the author</h2>
            {ap?.image
              ? <Cover cover={ap.image} alt={ap.imageAlt ?? d.author} widths={[160, 320]} sizes="10rem" class="author__img" />
              : <div class="author__img author__img--ph"><Visual art="lens" label={d.demo ? 'Author photo placeholder' : 'Author photo'} ratio="4 / 5" /></div>}
            <div class="author__text">
              <p class="eyebrow">About the author</p>
              <p class="author__name">{d.author}</p>
              {ap?.role && <p class="muted small">{ap.role}</p>}
              {ap
                ? <p>{ap.bio}</p>
                : <p class="muted">The writer’s full biography will appear here for each published article.</p>}
              {ap && ap.links.length > 0
                ? <ul class="author__links">{ap.links.map((l) => <li><a href={l.href} rel="noopener noreferrer" target="_blank">{l.label}<span class="sr-only"> (opens in a new tab)</span></a></li>)}</ul>
                : !ap && <p class="muted small">Links to the writer’s social channels will appear here.</p>}
            </div>
          </aside>
        )}
        <h2>Related</h2>
        <p class="muted small">Related research, podcast episodes will be linked here. See <a href="/african-intelligence">African Intelligence</a> and <a href="/research-and-publications">Research &amp; Publications</a>.</p>
      </div>
    </div>
  </article>
  <section class="section theme-charcoal">
    <div class="wrap"><div class="section-head"><p class="eyebrow">Keep reading</p><h2>More stories.</h2></div>
      <div class="grid">{(related.length ? related : more).map((r) => <StoryCard story={r} />)}</div></div>
  </section>
  {isOpEd ? <CtaBand title="Let’s work together." /> : <CtaBand />}
</BaseLayout>
<style>
  .oppo dl { display: grid; gap: 0.2rem; margin: 0.5rem 0; } .oppo dt { font-weight: 700; font-size: 0.85rem; margin-top: 0.5rem; } .oppo dd { margin: 0; color: var(--gray-ink); }
  .story__head { padding: calc(var(--header-h) + 3rem) 0 3rem; } .story__head .wrap { display: grid; gap: 1.2rem; justify-items: start; }
  h1 { font-weight: 800; font-size: var(--step-4); letter-spacing: -0.03em; max-width: 22ch; overflow-wrap: break-word; }
  .kindline { display: flex; flex-wrap: wrap; gap: 0.8rem 1.2rem; align-items: center; } .byline { color: var(--gray); font-size: 0.92rem; }
  .crumbs ol { display: flex; flex-wrap: wrap; gap: 0.4rem; font-size: 0.85rem; color: var(--gray); } .crumbs li + li::before { content: '/'; margin-right: 0.4rem; opacity: 0.6; } .crumbs a { text-decoration: none; }
  .hero-img { margin-top: -1px; padding-top: 2rem; }
  .story__grid { display: grid; gap: 2.5rem; padding-block: 3rem 5rem; }
  .prose { max-width: 44rem; display: grid; gap: 1.3rem; }
  .prose :global(h2) { font-family: var(--font-display); font-weight: 800; font-size: var(--step-2); margin-top: 1rem; }
  .prose :global(blockquote) { border-left: 4px solid var(--brand); padding-left: 1.2rem; color: var(--gray-ink); font-style: normal; margin: 0; }
  .pull { border-left: 4px solid var(--brand); padding-left: 1.2rem; font-family: var(--font-display); font-weight: 800; font-size: var(--step-3); line-height: 1.1; margin: 1.5rem 0; }
  .slot { margin: 1rem 0; display: grid; gap: 0.6rem; } .slot figcaption { font-size: 0.85rem; color: var(--gray-ink); }
  .author { display: grid; gap: 1.2rem; grid-template-columns: 7rem 1fr; align-items: start; margin-top: 2rem; padding: 1.5rem; border: 1px solid var(--line-light); background: var(--white); }
  .author :global(.author__img) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; } .author__text { display: grid; gap: 0.5rem; } .author__name { font-family: var(--font-display); font-weight: 800; font-size: var(--step-2); line-height: 1.1; }
  .author__links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.2rem; list-style: none; padding: 0; margin: 0.3rem 0 0; } .author__links a { color: var(--brand-ink); font-weight: 600; }
  @media (max-width: 520px) { .author { grid-template-columns: 1fr; } .author :global(.author__img) { max-width: 9rem; } }
  .small { font-size: 0.88rem; } .src { padding-left: 1.2rem; list-style: decimal; }
  .grid { display: grid; gap: 2.2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  @media (min-width: 900px) { .story__grid { grid-template-columns: 0.4fr 1fr; gap: 5rem; } .side { position: sticky; top: calc(var(--header-h) + 1.5rem); align-self: start; } }
</style>
