---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Visual from '../components/Visual.astro';
import CaseCards from '../components/CaseCards.astro';
import { capabilities } from '../data/capabilities';

const c = capabilities.find((x) => x.slug === 'narrative-engineering')!;
const contactHref = '/contact/narrative-engineering';
const pillarNo = '01';
---
<BaseLayout title={`${c.title} | Native Media`} description={`${c.tagline} ${c.intro[0]}`.slice(0, 300)}>
  <PageHero eyebrow={`What we do · ${pillarNo}`} title={c.title} lede={c.tagline}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'What We Do', href: '/what-we-do' }, { label: c.title }]}>
    <a class="btn" href={contactHref}>Start an inquiry <span aria-hidden="true">→</span></a>
  </PageHero>

  <section class="section theme-light">
    <div class="wrap split">
      <div class="stack">
        <p class="eyebrow">Our approach</p>
        <Visual art={c.art} label="Visual placeholder" ratio="4 / 3" />
      </div>
      <div class="stack">
        {c.intro.map((p, i) => <p class:list={{ lede: i === 0 }}>{p}</p>)}
        <h2 class="h2" style="margin-top:1rem">{c.includesTitle}</h2>
        <ul class="checklist">{c.includes.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section theme-dark">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">How we work</p><h2>A clear process, from context to delivery.</h2></div>
      <ol class="steps">{c.process.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}</ol>
    </div>
  </section>

  {c.principles && (
    <section class="section theme-light">
      <div class="wrap">
        <div class="section-head"><p class="eyebrow">Standards</p><h2>{c.principlesTitle}</h2></div>
        <div class="cards">{c.principles.map((p) => <div class="card"><h3>{p.title}</h3><p>{p.text}</p></div>)}</div>
      </div>
    </section>
  )}

  <section class={`section ${c.principles ? 'theme-charcoal' : 'theme-light'}`}>
    <div class="wrap split">
      <div class="stack">
        <p class="eyebrow">Working with us</p>
        <h2 class="h2">{c.engagementTitle}</h2>
        <p class="muted">Indicative models. Scope, timing and terms are agreed with each client.</p>
        <p class="muted small">Best suited to: {c.audiences.join(' · ')}</p>
      </div>
      <div class="cards">{c.engagement.map((e) => <div class="card"><h3>{e.title}</h3><p>{e.text}</p></div>)}</div>
    </div>
  </section>

  <section class="section theme-light" aria-labelledby="work-h">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Proof of work</p><h2 id="work-h">Case studies.</h2>
        <p class="lede">Selected projects, with the ask, our approach, what we delivered and what the evidence does and does not show.</p></div>
      <CaseCards />
      <p class="more"><a class="arrow-link" href="/case-studies">All case studies <span aria-hidden="true">→</span></a></p>
      <p class="muted small" style="margin-top:1.5rem">Related</p>
      <div class="related">{c.related.map((r) => <a class="arrow-link" href={r.href}>{r.label} <span aria-hidden="true">→</span></a>)}</div>
    </div>
  </section>

  <CtaBand title={`Discuss ${c.title.toLowerCase()} with Native Media.`} href="/contact" label="Make an inquiry" />
</BaseLayout>
<style>
  .cs-cards { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); } .cs-card { display: grid; gap: 0.6rem; align-content: start; } .cs-card__img { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #111; } .cs-card__img :global(img) { width: 100%; height: 100%; object-fit: cover; } .cs-card h3 { font-size: var(--step-1); font-weight: 800; line-height: 1.15; } .cs-card h3 a { text-decoration: none; } .cs-card h3 a:hover { color: var(--brand-ink); } .more { margin-top: 2rem; }
  .small { font-size: 0.88rem; }
</style>
