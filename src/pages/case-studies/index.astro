---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import CaseCards from '../../components/CaseCards.astro';
---
<BaseLayout title="Case studies | Native Media" description="Selected Native Media work: media coordination, stakeholder linkage and narrative strategy for national development, energy transition and banking communications in Tanzania.">
  <PageHero eyebrow="Our work" title="Case studies" lede="Selected projects in media coordination, stakeholder linkage and narrative strategy. Each case sets out the ask, our approach, what we delivered and what the evidence does and does not show."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'What We Do', href: '/what-we-do' }, { label: 'Narrative Engineering', href: '/narrative-engineering' }, { label: 'Case studies' }]} />
  <section class="section theme-light">
    <div class="wrap">
      <h2 class="sr-only">All case studies</h2>
      <CaseCards />
    </div>
  </section>
  <CtaBand title="Let’s work together." text="Tell us what you need to communicate and who needs to hear it." href="/contact/narrative-engineering" label="Narrative engineering inquiry" />
</BaseLayout>
