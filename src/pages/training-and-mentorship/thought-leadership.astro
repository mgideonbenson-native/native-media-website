---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
---
<BaseLayout title="Thought Leadership Development | Native Media" description="Thought leadership development from Native Media: practical training and mentorship to nurture Africa’s next thought leaders in communication.">
  <PageHero eyebrow="Training & Mentorship" title="Thought Leadership Development" lede="Nurturing thought leaders in the area of communication."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'What We Do', href: '/what-we-do' }, { label: 'Training & Mentorship', href: '/training-and-mentorship' }, { label: 'Thought Leadership Development' }]} />
  <section class="section theme-light">
    <div class="wrap split">
      <div class="stack"><p class="eyebrow">About</p><h2 class="h2">Bridging the gap between academic theory and field-level tactics.</h2>
        <p>We design and deliver training and mentorship that equip next-generation thought leaders with the practical skills to architect corporate reputation and manage continental narratives.</p>
        <p><a class="arrow-link" href="/training-and-mentorship/native-talks">See the Native Talks programme and apply <span aria-hidden="true">→</span></a></p></div>
      <div class="notice-box"><span class="tag tag--brand">To be confirmed</span><p>Native Media will add what thought leadership development includes beyond Native Talks, such as formats, facilitators and dates.</p></div>
    </div>
  </section>
  <CtaBand title="Interested in thought leadership development?" text="Tell us what you would like to know and we will reply." href="/contact/training-and-mentorship" label="Make an inquiry" />
</BaseLayout>
