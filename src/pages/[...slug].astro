---
/**
 * Holding page for every navigation link whose real page is built in a later phase.
 * When a real page is created (e.g. src/pages/about/index.astro) it automatically
 * takes priority over this one, so nothing needs to be deleted.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { allPaths, builtPaths, phaseFor } from '../data/site';

export function getStaticPaths() {
  return allPaths.filter((p) => !builtPaths.has(p.href)).map((p) => ({ params: { slug: p.href.slice(1) }, props: p }));
}
const { label, href } = Astro.props;
const { phase, note } = phaseFor(href);
---
<BaseLayout title={`${label} | Native Media`} description={`${label} at Native Media. This page is planned for a later build phase.`} noindex>
  <section class="hold theme-dark">
    <div class="wrap">
      <p class="eyebrow">Native Media</p>
      <h1>{label}</h1>
      <p class="lede">This page is planned for <strong>Phase {phase}</strong> of the build: {note.toLowerCase()}.</p>
      <p class="tag">Placeholder page · not yet built</p>
      <p class="hold__links"><a class="btn" href="/">Back to home</a> <a class="btn btn--ghost" href="/contact">Inquire</a></p>
    </div>
  </section>
</BaseLayout>
<style>
  .hold { min-height: 80svh; display: flex; align-items: center; padding-top: calc(var(--header-h) + 3rem); }
  .hold .wrap { display: grid; gap: 1.4rem; justify-items: start; }
  h1 { font-size: var(--step-4); font-weight: 800; overflow-wrap: break-word; }
  .hold__links { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 0.6rem; }
</style>
