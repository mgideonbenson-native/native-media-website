---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { REVIEW_BASE, reviewMeta } from '../../data/review';
import { publicationSections as sections } from '../../data/intelligence';
export function getStaticPaths() { return Object.keys(sections).map((section) => ({ params: { section } })); }
const { section } = Astro.params as { section: keyof typeof sections };
const m = sections[section];
---
<BaseLayout title={`${m.title} | Publications | Native Media`} description={m.lede}>
  <PageHero eyebrow="Publications" title={m.title} lede={m.lede} crumbs={[{ label: 'Home', href: '/' }, { label: 'Research & Publications', href: '/research-and-publications' }, { label: m.title }]} />
  <section class="section theme-light"><div class="wrap split">
    <div class="stack"><h2 class="h2">Available now</h2>
      <div class="notice-box"><span class="tag tag--brand">None published</span><p>{m.empty}</p></div></div>
    <div class="stack"><h2 class="h2">In preparation</h2>
      <div class="card"><h3><a href={REVIEW_BASE}>{reviewMeta.title}</a></h3><p>{reviewMeta.edition.label}: {reviewMeta.edition.status.toLowerCase()}.</p><a class="arrow-link" href={REVIEW_BASE}>View status <span aria-hidden="true">→</span></a></div></div>
  </div></section>
</BaseLayout>
<style>.card h3 a { text-decoration: none; } .card h3 a:hover { color: var(--brand-ink); }</style>
