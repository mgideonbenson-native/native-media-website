---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PublicationList from '../../components/PublicationList.astro';
import CtaBand from '../../components/CtaBand.astro';
import { publicationKinds } from '../../data/publications';
const all = (await getCollection('publications')).sort((a, b) => b.data.year - a.data.year);
const featured = all.filter((p) => p.data.featured);
const shown = featured.length ? featured : all.slice(0, 6);
---
<BaseLayout title="Research & Publications | Native Media" description="Reports and research from leading organizations, featured by Native Media with clear credit and a link to the original." noindex={all.length === 0}>
  <PageHero eyebrow="What we do · 02" title="Research & Publications" lede="Reports and research from leading organizations, featured for people who need to understand Africa. Every item is credited and linked to its original."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'What We Do', href: '/what-we-do' }, { label: 'Research & Publications' }]} />
  <section class="section theme-light" aria-labelledby="feat-t">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Featured</p><h2 id="feat-t">Featured publications.</h2></div>
      <PublicationList items={shown} empty="Featured reports and research from other organizations will be listed here." />
    </div>
  </section>
  <section class="section theme-dark">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Browse</p><h2>By type.</h2></div>
      <ul class="cards">{Object.values(publicationKinds).map((k) => <li class="card"><h3><a href={`/research-and-publications/${k.slug}`}>{k.label}</a></h3><p>{k.lede}</p><a class="arrow-link" href={`/research-and-publications/${k.slug}`}>Open <span aria-hidden="true">→</span></a></li>)}</ul>
      <p class="more"><a class="arrow-link" href="/research-and-publications/third-party-research">How we feature other organizations’ work <span aria-hidden="true">→</span></a></p>
    </div>
  </section>
  <CtaBand title="Have research we should feature?" text="Tell us about it, who it is for and where it has appeared. We will reply about fit and permissions." href="/contact/research-collaboration" label="Research inquiry" />
</BaseLayout>
<style>.card h3 a { text-decoration: none; } .card h3 a:hover { color: var(--brand); } .more { margin-top: 2rem; }</style>
