---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import CtaBand from '../../../components/CtaBand.astro';
import ReviewTabs from '../../../components/ReviewTabs.astro';
import * as R from '../../../data/review';
import { getCorrections, getProfiles, getSponsors } from '../../../lib/review-cms';
import { reviewSections as sections } from '../../../data/review';

export function getStaticPaths() { return Object.keys(sections).map((section) => ({ params: { section } })); }
const { section } = Astro.params as { section: keyof typeof sections };
const meta = sections[section];
const [corrections, sponsors, profiles] = await Promise.all([getCorrections(), getSponsors(), getProfiles()]);
const pending = (what: string) => `${what} will appear here once Edition 01 is published.`;
---
<BaseLayout title={`${meta.title} | Economic Diplomacy Review`} description={meta.lede}>
  <PageHero eyebrow="Tanzania Economic Diplomacy Review" title={meta.title} lede={meta.lede}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Research & Publications', href: '/research-and-publications' }, { label: 'Tanzania Economic Diplomacy Review', href: R.REVIEW_BASE }, { label: meta.title }]}>
    <p><span class="tag tag--brand">{R.reviewMeta.status}</span></p>
  </PageHero>
  <ReviewTabs />

  {section === 'chapters' && (
    <section class="section theme-light"><div class="wrap">
      <p class="lede" style="margin-bottom:2rem">Each chapter is designed to carry: {R.chapterElements.join(', ').toLowerCase()}.</p>
      <ol class="chlist">
        {R.chapters.map((c) => (
          <li id={`chapter-${c.n}`} class="ch"><span class="ch__n">{String(c.n).padStart(2, '0')}</span>
            <div><h2>{c.title}</h2><ul class="chips">{c.topics.map((t) => <li>{t}</li>)}</ul>
              <p class="muted small">Findings and data exhibits are published with the edition, each with its source and reporting period.</p></div></li>
        ))}
      </ol>
      <div class="notice-box" style="margin-top:2rem"><span class="tag">Also in Part One</span><p>{R.partOneFeature}.</p></div>
    </div></section>
  )}

  {section === 'opportunity-atlas' && (
    <section class="section theme-light"><div class="wrap split">
      <div class="stack"><h2 class="h2">Seven sectors</h2><p class="muted">The atlas opens with a partnership matrix showing who works where, then one spread per sector.</p></div>
      <ol class="chlist">{R.opportunitySectors.map((s, i) => <li class="ch"><span class="ch__n">{String(i + 1).padStart(2, '0')}</span><div><h2>{s}</h2><p class="muted small">Sector content is being verified for Edition 01.</p></div></li>)}</ol>
    </div></section>
  )}

  {section === 'embassy-profiles' && (<>
    <section class="section theme-light"><div class="wrap split">
      <div class="stack"><h2 class="h2">One structure for every profile</h2>
        <p class="muted">Every profile follows the same nine sections. Missions are grouped by region and listed alphabetically within each region. No ranking is implied.</p>
        <div class="notice-box"><span class="tag tag--brand">Awaiting embassy review</span><p>Profiles are compiled from public statements and statistics. They are not published as final until the mission has checked them and signed them off. Ambassadors’ messages are left blank until supplied and signed.</p></div></div>
      <ol class="steps">{R.profileSections.map((s) => <li><h3>{s}</h3></li>)}</ol>
    </div></section>
    <section class="section theme-dark"><div class="wrap split">
      <div class="stack"><h2 class="h2">Where verified, each profile can include</h2></div>
      <ul class="checklist">{R.profileFields.map((f) => <li>{f}</li>)}</ul>
    </div></section>
    <section class="section theme-light"><div class="wrap">
      <div class="section-head"><p class="eyebrow">Directory by region</p><h2>Participating missions.</h2><p class="lede">Ten partner profiles are planned for Edition 01. Missions are named here only once their participation is confirmed and permission to publish has been given.</p></div>
      <ul class="cards">{R.regions.map((r) => {
        const list = profiles.filter((p) => p.region === r);
        return <li class="card"><h3>{r}</h3>{list.length > 0
          ? <ul>{list.map((p) => <li><a class="arrow-link" href={`${R.REVIEW_BASE}/embassy-profiles/${p.slug}`}>{p.country} <span aria-hidden="true">→</span></a></li>)}</ul>
          : <><p>No missions confirmed yet.</p><span class="tag">Awaiting confirmation</span></>}</li>;
      })}</ul>
    </div></section>
  </>)}

  {section === 'directory-and-data' && (<>
    <section class="section theme-light"><div class="wrap split">
      <div class="stack"><h2 class="h2">In Part Four</h2><p class="muted">Search, filters, references and historical data will be added where available.</p></div>
      <ul class="checklist" style="grid-template-columns:1fr">{R.partFourContents.map((c) => <li>{c}</li>)}</ul>
    </div></section>
    <section class="section theme-dark"><div class="wrap split">
      <div class="stack"><h2 class="h2">Planned reference sets</h2></div>
      <ul class="checklist">{R.directorySets.map((c) => <li>{c}</li>)}</ul>
    </div></section>
  </>)}

  {section === 'quarterly-updates' && (
    <section class="section theme-light"><div class="wrap split">
      <div class="stack"><h2 class="h2">What an update covers</h2>
        <ul class="checklist" style="grid-template-columns:1fr">{R.quarterlyContents.map((c) => <li>{c}</li>)}</ul></div>
      <div class="stack"><h2 class="h2">Every update shows</h2>
        <ul class="chips">{R.updateFields.map((f) => <li>{f}</li>)}</ul>
        <div class="notice-box"><span class="tag">None published yet</span><p>{pending('Quarterly updates and their archive')}</p></div></div>
    </div></section>
  )}

  {section === 'digital-edition' && (
    <section class="section theme-light"><div class="wrap split">
      <div class="stack"><h2 class="h2">Reading experience</h2><div class="notice-box"><span class="tag">Not yet available</span><p>{pending('The digital edition')}</p></div></div>
      <ul class="checklist" style="grid-template-columns:1fr">{R.digitalFeatures.map((c) => <li>{c}</li>)}</ul>
    </div></section>
  )}

  {section === 'methodology' && (<>
    <section class="section theme-light"><div class="wrap">
      <div class="section-head"><p class="eyebrow">Source hierarchy</p><h2>Three tiers of sources.</h2></div>
      <ul class="cards">{R.sourceTiers.map((t) => <li class="card"><span class="eyebrow">{t.tier}</span><h3>{t.title}</h3><p>{t.items.join(' · ')}</p></li>)}</ul>
    </div></section>
    <section class="section theme-dark"><div class="wrap split">
      <div class="stack"><h2 class="h2">Rules for every data point</h2></div>
      <ul class="checklist" style="grid-template-columns:1fr">{R.sourceRules.map((c) => <li>{c}</li>)}</ul>
    </div></section>
    <section class="section theme-light"><div class="wrap">
      <div class="section-head"><p class="eyebrow">Editorial principles</p><h2>Six principles.</h2></div>
      <ul class="cards">{R.principles.map((p) => <li class="card"><h3>{p.title}</h3><p>{p.text}</p></li>)}</ul>
    </div></section>
    <section class="section theme-charcoal"><div class="wrap">
      <div class="section-head"><p class="eyebrow">Status labels</p><h2>What each label means.</h2></div>
      <div class="cards">
        {Object.entries(R.statusLabels).map(([group, rows]) => (
          <div class="card"><h3>{group === 'publication' ? 'Publication status' : group === 'verification' ? 'Verification status' : 'Participation status'}</h3>
            <dl>{rows.map(([l, d]) => <><dt>{l}</dt><dd>{d}</dd></>)}</dl></div>
        ))}
      </div>
      <p class="muted small" style="margin-top:1.5rem">Reporting period: {R.reviewMeta.edition.label}. {R.reviewMeta.edition.cutoff}. Each figure also carries its own reference period.</p>
    </div></section>
  </>)}

  {section === 'sponsorship' && (
    <section class="section theme-light"><div class="wrap split">
      <div class="stack"><h2 class="h2">Our rules</h2>
        <ul class="checklist" style="grid-template-columns:1fr">{R.sponsorshipRules.map((c) => <li>{c}</li>)}</ul></div>
      <div class="stack"><h2 class="h2">Confirmed sponsors</h2>
        {sponsors.length > 0
          ? <ul class="sp">{sponsors.map((s) => <li><strong>{s.name}</strong>: {s.role}{s.scope ? `, ${s.scope}` : ''}{s.confirmedOn ? ` (confirmed ${s.confirmedOn})` : ''}</li>)}</ul>
          : <div class="notice-box"><span class="tag">None confirmed</span><p>No sponsor has been confirmed. When one is, its name and agreed role will be listed here.</p></div>}
        <h3 class="h3">Ways to support</h3>
        <ul class="chips"><li>Institutional advertising</li><li>Edition partnerships</li><li>Thematic sponsorships</li><li>Sponsored features</li></ul>
        <a class="btn" href="/contact/institutional-partnerships">Sponsorship inquiry <span aria-hidden="true">→</span></a></div>
    </div></section>
  )}

  {section === 'corrections' && (
    <section class="section theme-light"><div class="wrap split">
      <div class="stack"><h2 class="h2">How corrections work</h2>
        <p>Errors will be corrected in the next quarterly digital update and listed on this page. The original wording, the correction and the date are all preserved.</p>
        <p class="muted">To report a possible error, include the page or figure, what you believe is wrong, and a source.</p>
        <a class="btn" href="/contact/general-inquiries">Report an error <span aria-hidden="true">→</span></a></div>
      <div class="stack"><h2 class="h2">Corrections log</h2>
        {corrections.length > 0
          ? <ul class="corr">{corrections.map((c) => <li><strong>{c.date}: {c.item}</strong>{c.original && <p><span class="muted">Originally:</span> {c.original}</p>}<p><span class="muted">Corrected to:</span> {c.corrected}</p>{c.reason && <p class="muted small">{c.reason}</p>}</li>)}</ul>
          : <div class="notice-box"><span class="tag">No corrections</span><p>No edition has been published, so there are no corrections to report.</p></div>}</div>
    </div></section>
  )}

  <CtaBand title="Take part in the Review." text="Missions and institutions can ask how profiles are verified, and organizations can ask about partnerships and sponsorship." href="/contact/institutional-partnerships" label="Partnership inquiry" />
</BaseLayout>
<style>
  .chlist { display: grid; gap: 0; } .ch { display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding: 1.5rem 0; border-bottom: 1px solid var(--line-light); }
  .ch__n { font-family: var(--font-display); font-weight: 800; font-size: var(--step-2); color: var(--brand-ink); } .ch h2 { font-family: var(--font-display); font-weight: 800; font-size: var(--step-2); margin-bottom: 0.7rem; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; } .chips li { font-family: var(--font-display); font-weight: 600; font-size: 0.85rem; padding: 0.45rem 0.9rem; border: 1px solid var(--line-light); border-radius: 999px; }
  .small { font-size: 0.88rem; margin-top: 0.7rem; } .h3 { font-family: var(--font-display); font-weight: 800; font-size: var(--step-1); }
  .steps li { padding: 1rem 1.2rem; } .steps h3 { font-size: 1rem; }
  dt { font-family: var(--font-display); font-weight: 800; margin-top: 0.8rem; } dd { margin: 0.1rem 0 0; font-size: 0.9rem; color: var(--gray); }
  .card .tag { justify-self: start; } .corr, .sp { display: grid; gap: 1.2rem; } .corr li { border-bottom: 1px solid var(--line-light); padding-bottom: 1rem; display: grid; gap: 0.3rem; }
</style>
