---
/**
 * Interactive edition of PwC's Africa Entertainment and Media Outlook 2026–2030 (South Africa, Kenya, Nigeria).
 * Shown with PwC's permission. Every figure comes from data/africa-em-outlook-2026.json, which records the page and wording.
 * Check the figures against the PDF with: node scripts/verify-report-data.mjs data/africa-em-outlook-2026.json <pdf>
 * Text marked "Native Media perspective" is editorial interpretation, not PwC analysis.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChartFrame from '../../components/report/ChartFrame.astro';
import Bars from '../../components/report/Bars.astro';
import LineChart from '../../components/report/LineChart.astro';
import Stat from '../../components/report/Stat.astro';
import ReportNav from '../../components/report/ReportNav.astro';
import cover from '../../assets/publications/pwc-africa-entertainment-media-outlook-2026.jpg';
import data from '../../../data/africa-em-outlook-2026.json';

const { meta, facts: F, tipping_points: tips, countries: C } = data as any;
const src = (...ids: string[]) => `PwC Africa E&M Outlook 2026–2030, p. ${[...new Set(ids.map((id) => F[id].page))].join(', ')}`;
const srcT = (k: string) => `PwC Africa E&M Outlook 2026–2030, p. ${C[k].page} (table)`;
const years: number[] = meta.years;
const markets = [
  { k: 'sa', name: 'South Africa', short: 'SA', tone: 'brand' as const, angle: 'Africa’s largest and most mature market', outlook: 'Value is moving between segments. Digital categories grow while established formats lose share without disappearing. The challenge is less about growing audiences and more about adapting to how they consume and pay.', facts: ['sa_local70', 'sa_music', 'sa_tv_decline'] },
  { k: 'ke', name: 'Kenya', short: 'KE', tone: 'paper' as const, angle: 'A mobile-first digital economy', outlook: 'Traditional and digital media are growing at the same time. Connectivity dominates, while digital advertising and OTT video become more important sources of future value.', facts: ['ke_conn_share', 'ke_ads_fastest', 'ke_ott'] },
  { k: 'ng', name: 'Nigeria', short: 'NG', tone: 'gray' as const, angle: 'The fastest-growing of the three', outlook: 'Strong demographics and broad growth: many categories are expanding at once, which shows how much headroom remains.', facts: ['ng_ott_fastest', 'ng_gaming', 'nollywood'] },
];
const seg = (k: string, s: string) => C[k].segments[s];
const v25 = (k: string, s: string) => seg(k, s).values[4];
const v30 = (k: string, s: string) => seg(k, s).values[9];
const usdBn = (k: string) => C[k].total.values.map((v: number) => Math.round(v / 100) / 10);
const fmtM = (v: number) => (v >= 1000 ? `$${(v / 1000).toFixed(1)}bn` : `$${v}m`);
const segOrder = ['Connectivity', 'Internet advertising', 'Traditional TV', 'Video games & esports', 'Music, radio & podcasts', 'OTT video', 'Newspapers, magazines & books', 'Business-to-business', 'Out-of-home advertising', 'Cinema'];
const pdfName = 'PwC-Africa-Entertainment-Media-Outlook-2026-2030.pdf';
const sections = [
  { id: 'opening', label: 'The opening' },
  { id: 'markets', label: 'Three markets' },
  { id: 'connectivity', label: 'Connectivity' },
  { id: 'advertising', label: 'Advertising' },
  { id: 'consumption', label: 'Video and gaming' },
  { id: 'live', label: 'Shared experiences' },
  { id: 'next', label: 'The next phase' },
  { id: 'takeaways', label: 'Key takeaways' },
  { id: 'report', label: 'The original report' },
];
const num = (id: string) => String(sections.findIndex((s) => s.id === id) + 1).padStart(2, '0');
const tipYears = [...new Set(tips.map((t: any) => t.year))] as number[];
---
<BaseLayout title="Africa Entertainment & Media Outlook 2026–2030, interactive | Native Media"
  description="An interactive edition of PwC’s Africa Entertainment and Media Outlook 2026–2030. Explore how South Africa, Kenya and Nigeria are growing across connectivity, advertising, streaming, gaming, music and cinema."
  image="/reports/og-africa-entertainment-media-outlook-2026.png"
  jsonLd={{ '@context': 'https://schema.org', '@type': 'Article', headline: 'From access to attention: Africa’s entertainment and media to 2030', about: meta.title, author: { '@type': 'Organization', name: 'Native Media' }, isBasedOn: { '@type': 'Report', name: meta.title, publisher: { '@type': 'Organization', name: 'PwC' }, url: meta.url, datePublished: '2026-10' } }}>

  <div class="rp" data-rp data-share-text="From access to attention: an interactive edition of PwC’s Africa Entertainment and Media Outlook 2026–2030.">
    <ReportNav sections={sections} pdf={meta.url} pdfName={pdfName} pdfLabel="Read the original (PwC, PDF)" />

    <!-- 01 OPENING -->
    <section class="op" id="opening" aria-labelledby="op-t" data-rp-section>
      <canvas class="op__topo" data-topo aria-hidden="true"></canvas>
      <div class="op__grain" aria-hidden="true"></div>
      <div class="wrap op__inner">
        <nav aria-label="Breadcrumb" class="crumbs"><ol><li><a href="/">Home</a></li><li><a href="/research-and-publications">Research &amp; Publications</a></li><li><span aria-current="page">Africa E&amp;M Outlook 2026–2030</span></li></ol></nav>
        <div class="op__grid">
          <div class="op__text">
            <p class="eyebrow">Interactive report · PwC · 2026–2030</p>
            <h1 id="op-t" class="op__h" tabindex="-1"><span>From access</span> <span>to <em>attention.</em></span></h1>
            <p class="op__sub">How South Africa, Kenya and Nigeria are turning connectivity into entertainment, advertising and culture, from PwC’s Africa Entertainment and Media Outlook 2026–2030.</p>
            <p class="op__intro">PwC forecasts revenue in ten entertainment and media segments, from mobile data to cinema tickets, in three markets: South Africa, Kenya and Nigeria. Its theme is “digital growth, human connection”. Native Media has turned it into an interactive edition. Every number comes from the report, with its page.</p>
          </div>
          <a class="op__cover" href="#report" aria-label="About the original report">
            <Image src={cover} alt="Cover of PwC’s Africa Entertainment and Media Outlook 2026–2030: Digital growth, human connection" widths={[260, 420, 560]} sizes="(min-width: 64rem) 17rem, 12rem" loading="eager" />
          </a>
        </div>
        <div class="op__stats">
          <Stat value={6.9} decimals={1} suffix="%" label="a year: Nigeria’s E&M growth to 2030, the fastest of the three markets" source={`CAGR 2025–2030 · ${src('ng_total')}`} />
          <Stat value={14} decimals={1} suffix="%" label="a year: Kenya’s internet advertising growth, the fastest internet advertising market in the world" source={`CAGR 2025–2030 · ${src('ke_ads_fastest')}`} />
          <Stat value={20.4} decimals={1} suffix="%" label="a year: Nigeria’s OTT video growth, the fastest OTT market globally" source={`CAGR 2025–2030 · ${src('ng_ott_fastest')}`} />
        </div>
        <div class="op__actions">
          <a class="btn" href="#markets">Explore the report <span aria-hidden="true">↓</span></a>
          <button type="button" class="btn btn--ghost" data-rp-share>Share <span aria-hidden="true">↗</span></button>
          <a class="btn btn--ghost" href={meta.url} target="_blank" rel="noopener noreferrer">Read the original (PwC, PDF) <span aria-hidden="true">↗</span></a>
          <p class="share-msg" data-rp-share-msg role="status" aria-live="polite"></p>
        </div>
      </div>
    </section>

    <!-- 02 MARKETS -->
    <section class="sec theme-dark" id="markets" aria-labelledby="mk-t" data-rp-section>
      <div class="wrap">
        <header class="sec__head"><span class="sec__n" aria-hidden="true">{num('markets')}</span><div><p class="eyebrow">Three markets, three perspectives</p><h2 id="mk-t">South Africa is biggest. Nigeria is fastest. Kenya runs on connectivity.</h2>
          <p class="lede">All three are forecast to grow, at different speeds and from different starting points. South Africa grows at 3.2% a year, a little below the global 3.4%; Kenya at 5.0%; Nigeria at 6.9%.</p></div></header>

        <div class="grid2 grid2--wide">
          <ChartFrame title="Total entertainment and media revenue, 2021–2030" explain="All three markets in US dollars. 2021–2024 are historical, 2025 is the base year and 2026–2030 are PwC forecasts. Tap a point for its value." unit="US$ billions (rounded from US$ millions)" period="2021–2030" source={`${srcT('sa')}; p. ${C.ke.page}; p. ${C.ng.page}`} note={`South Africa in rand: R${(C.sa_zar.total.values[4] / 1000).toFixed(1)}bn in 2025 to R${(C.sa_zar.total.values[9] / 1000).toFixed(1)}bn in 2030. ${F.double_count.label} (p. ${F.double_count.page}).`}>
            <LineChart years={years} projectedFrom={2026} projLabel="Forecast" yMin={0} yMax={20} step={5} prefix="$" suffix="bn" label="Total E&M revenue by market 2021 to 2030" series={markets.map((m) => ({ label: m.name, values: usdBn(m.k), tone: m.tone }))} />
          </ChartFrame>
          <ChartFrame title="Growth rate to 2030" explain="Compound annual growth rate of total E&M revenue, 2025–2030, against PwC’s global forecast." unit="% a year (CAGR)" period="2025–2030" source={src('ng_total', 'global_cagr')}>
            <Bars label="E&M revenue growth rate by market" max={8} decimals={1} items={[
              { label: 'Nigeria', value: C.ng.total.cagr }, { label: 'Kenya', value: C.ke.total.cagr },
              { label: 'Global', value: 3.4, tone: 'muted' }, { label: 'South Africa', value: C.sa.total.cagr },
            ]} />
          </ChartFrame>
        </div>

        <h3 class="h3 sub">Explore a market</h3>
        <div class="tabs" data-tabs>
          <div class="tabs__list" role="tablist" aria-label="Choose a market">
            {markets.map((m) => <button type="button" role="tab" id={`t-${m.k}`} aria-controls={`p-${m.k}`} data-tab={m.k}>{m.name}</button>)}
          </div>
          {markets.map((m) => (
            <div role="tabpanel" id={`p-${m.k}`} aria-labelledby={`t-${m.k}`} data-panel={m.k} class="panel">
              <div class="mkt__head"><p class="eyebrow">{m.angle}</p><p class="mkt__big">{fmtM(C[m.k].total.values[4])} <span>→</span> {fmtM(C[m.k].total.values[9])}</p><p class="muted">Total E&amp;M revenue, 2025 to 2030 · {C[m.k].total.cagr}% a year</p></div>
              <div class="panel__grid">
                <ChartFrame title={`${m.name}: where the money is in 2030`} explain="Forecast revenue by segment in 2030. Tap a bar to compare with 2025." unit="US$ millions" period="2030 forecast (vs 2025)" source={srcT(m.k)}>
                  <Bars label={`${m.name} revenue by segment in 2030`} suffix="" max={Math.max(...segOrder.map((s) => v30(m.k, s)))} items={segOrder.map((s, i) => ({ label: s, value: v30(m.k, s), display: fmtM(v30(m.k, s)), tone: i === 0 ? 'peer' as const : 'tz' as const, tip: `${s}: ${fmtM(v25(m.k, s))} in 2025 → ${fmtM(v30(m.k, s))} in 2030` }))} />
                </ChartFrame>
                <ChartFrame title={`${m.name}: what grows fastest`} explain="Compound annual growth rate by segment, 2025–2030. Bars to the left are shrinking." unit="% a year (CAGR)" period="2025–2030" source={srcT(m.k)}>
                  <Bars decimals={1} label={`${m.name} segment growth rates`} min={Math.min(-5, ...segOrder.map((s) => seg(m.k, s).cagr))} max={Math.max(...segOrder.map((s) => seg(m.k, s).cagr)) + 1}
                    items={[...segOrder].sort((a, b) => seg(m.k, b).cagr - seg(m.k, a).cagr).map((s) => ({ label: s, value: seg(m.k, s).cagr, tone: seg(m.k, s).cagr < 0 ? 'muted' as const : 'tz' as const }))} />
                </ChartFrame>
              </div>
              <div class="mkt__foot">
                <div class="means"><p class="means__k">PwC’s industry outlook</p><p>{m.outlook}</p></div>
                <ul class="mini">{m.facts.map((id) => <li><b>{F[id].display}</b><span>{F[id].label}</span><small>{F[id].period} · p. {F[id].page}</small></li>)}</ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 03 CONNECTIVITY -->
    <section class="sec theme-charcoal" id="connectivity" aria-labelledby="cn-t" data-rp-section>
      <div class="wrap">
        <header class="sec__head"><span class="sec__n" aria-hidden="true">{num('connectivity')}</span><div><p class="eyebrow">Connectivity and audience growth</p><h2 id="cn-t">Access is still the biggest business.</h2>
          <p class="lede">In mature markets, advertising is on track to overtake spending on connectivity. In Africa, mobile and fixed internet access is still the largest share of entertainment and media spend, and the base for everything else.</p></div></header>
        <div class="grid2">
          <ChartFrame title="Connectivity’s share of all E&M revenue in 2030" explain="Mobile and fixed internet access as a share of each market’s total. While access takes most of the wallet, other segments have less to draw on." unit="% of total E&M revenue" period="2030 forecast" source={src('conn_share')} note={F.conn_share.note}>
            <Bars label="Connectivity share of E&M revenue" max={100} items={[{ label: 'Kenya', value: 75 }, { label: 'Nigeria', value: 66 }, { label: 'South Africa', value: 60 }]} />
          </ChartFrame>
          <ChartFrame title="5G becomes the main network" explain="5G penetration in 2030. Faster, more reliable networks carry the video, gaming and social platforms that need bandwidth." unit="% 5G penetration" period="2030 forecast" source={src('g5')} note={`3G and older networks fall to ${F.g3.display} of subscriptions (South Africa / Kenya / Nigeria).`}>
            <Bars label="5G penetration in 2030" max={100} items={[{ label: 'South Africa', value: 86.8 }, { label: 'Kenya', value: 51.6 }, { label: 'Nigeria', value: 35.3 }]} />
          </ChartFrame>
        </div>
        <div class="grid3">
          <div class="card"><p class="card__k">South Africa</p><b class="card__n">79.4%</b><p>of all data consumed in 2025 was video. Network demand is now driven by entertainment, not basic communication.</p><small>{src('video_data')}</small></div>
          <div class="card"><p class="card__k">Across Africa</p><b class="card__n">Fixed &gt; mobile</b><p>Fixed broadband is growing faster than mobile, though Africa stays mobile-first because of last-mile challenges. Fixed lines widen the audience for streaming, gaming and connected TV.</p><small>{src('fixed_faster')}</small></div>
          <div class="card"><p class="card__k">Connectivity revenue, 2025 → 2030</p><b class="card__n">{C.ng.segments.Connectivity.cagr}% a year</b><p>Nigeria’s connectivity spend grows fastest: {fmtM(v25('ng', 'Connectivity'))} to {fmtM(v30('ng', 'Connectivity'))}. Kenya {fmtM(v25('ke', 'Connectivity'))} to {fmtM(v30('ke', 'Connectivity'))}; South Africa {fmtM(v25('sa', 'Connectivity'))} to {fmtM(v30('sa', 'Connectivity'))}.</p><small>{srcT('sa')}, {C.ke.page}, {C.ng.page}</small></div>
        </div>
        <p class="pull">“Quality and affordability, not simply the number of people connected, will determine how quickly consumers increase their engagement with streaming, gaming, and other digital services.” <small>p. 14</small></p>
      </div>
    </section>

    <!-- 04 ADVERTISING -->
    <section class="sec theme-dark" id="advertising" aria-labelledby="ad-t" data-rp-section>
      <div class="wrap">
        <header class="sec__head"><span class="sec__n" aria-hidden="true">{num('advertising')}</span><div><p class="eyebrow">Advertising, measurement and monetisation</p><h2 id="ad-t">Connectivity builds the audience. Advertising turns it into money.</h2>
          <p class="lede">Internet advertising grows in all three markets, fastest in Kenya. The money is following formats that can show results: video, retail search and connected TV.</p></div></header>
        <div class="grid2">
          <ChartFrame title="Internet advertising, 2025 and 2030" explain="Revenue in each market. Kenya’s almost doubles. South Africa stays by far the largest." unit="US$ millions" period="2025 → 2030 (forecast)" source={src('ke_ads_double')}>
            <Bars label="Internet advertising revenue" suffix="" max={3200} items={markets.flatMap((m) => [
              { label: `${m.name} 2025`, value: v25(m.k, 'Internet advertising'), display: fmtM(v25(m.k, 'Internet advertising')), tone: 'peer' as const },
              { label: `${m.name} 2030`, value: v30(m.k, 'Internet advertising'), display: fmtM(v30(m.k, 'Internet advertising')), status: 'forecast' as const, tip: `${m.name}: ${fmtM(v30(m.k, 'Internet advertising'))} forecast for 2030, ${seg(m.k, 'Internet advertising').cagr}% a year` },
            ])} />
          </ChartFrame>
          <div class="facts">
            <div class="fact"><b>18.2%</b><span>a year: Kenya’s video internet advertising, overtaking other display advertising in 2027</span><small>2025–2030 · {src('ke_video_ads')}</small></div>
            <div class="fact"><b>17.2%</b><span>a year: Nigeria’s retail paid search, overtaking traditional paid search by 2028</span><small>2025–2030 · {src('ng_retail_search')}</small></div>
            <div class="fact"><b>Connected TV</b><span>gives South African advertisers television-scale audiences with digital targeting and measurement</span><small>By 2030 · {src('sa_ctv')}</small></div>
          </div>
        </div>
        <p class="hatch-note"><i aria-hidden="true"></i>Hatched bars are forecasts.</p>

        <h3 class="h3 sub">Tipping points, year by year</h3>
        <p class="muted sub__lede">When a newer format overtakes an older one, in Africa and globally. Choose a year.</p>
        <div class="tabs tips" data-tabs>
          <div class="tabs__list tips__years" role="tablist" aria-label="Choose a year">
            {tipYears.map((y) => <button type="button" role="tab" id={`t-y${y}`} aria-controls={`p-y${y}`} data-tab={`y${y}`}>{y}</button>)}
          </div>
          {tipYears.map((y) => (
            <div role="tabpanel" id={`p-y${y}`} aria-labelledby={`t-y${y}`} data-panel={`y${y}`} class="panel">
              <ul class="tips__list">
                {tips.filter((t: any) => t.year === y).map((t: any) => <li class:list={['tip', { 'tip--global': t.market === 'Global' }]}><span class="tip__m">{t.market}</span><b>{t.text}</b></li>)}
              </ul>
            </div>
          ))}
        </div>
        <p class="srcline">Years read from the report’s tipping-points timeline, p. 4.</p>
      </div>
    </section>

    <!-- 05 CONSUMPTION -->
    <section class="sec theme-charcoal" id="consumption" aria-labelledby="cs-t" data-rp-section>
      <div class="wrap">
        <header class="sec__head"><span class="sec__n" aria-hidden="true">{num('consumption')}</span><div><p class="eyebrow">Evolving patterns of consumption</p><h2 id="cs-t">Streaming rises everywhere. Only in South Africa does TV shrink.</h2>
          <p class="lede">The pull between streaming (OTT) and traditional TV plays out differently in each market. Gaming grows faster than the global market in all three, carried by the smartphone.</p></div></header>

        <div class="tabs" data-tabs>
          <div class="tabs__list" role="tablist" aria-label="Choose a market">
            {markets.map((m) => <button type="button" role="tab" id={`t-v${m.k}`} aria-controls={`p-v${m.k}`} data-tab={`v${m.k}`}>{m.name}</button>)}
          </div>
          {markets.map((m) => {
            const tv = seg(m.k, 'Traditional TV'); const ott = seg(m.k, 'OTT video');
            const max = Math.max(...tv.values, ...ott.values);
            const step = max > 1500 ? 500 : 100;
            return (
              <div role="tabpanel" id={`p-v${m.k}`} aria-labelledby={`t-v${m.k}`} data-panel={`v${m.k}`} class="panel">
                <div class="panel__grid">
                  <ChartFrame title={`${m.name}: traditional TV and OTT video`} explain="Revenue each year. 2026–2030 are forecasts. Tap a point for its value." unit="US$ millions" period="2021–2030" source={srcT(m.k)}>
                    <LineChart years={years} projectedFrom={2026} projLabel="Forecast" yMin={0} yMax={Math.ceil(max / step) * step} step={step} prefix="$" suffix="m" decimals={0} label={`${m.name} traditional TV and OTT revenue 2021 to 2030`}
                      series={[{ label: 'Traditional TV', values: tv.values, tone: 'paper' }, { label: 'OTT video', values: ott.values, tone: 'brand' }]} />
                  </ChartFrame>
                  <div class="facts">
                    <div class="fact"><b>{ott.cagr}% vs {tv.cagr}%</b><span>a year: OTT video against traditional TV, 2025–2030</span><small>{src('ott_tv_table')}</small></div>
                    <div class="fact"><b>{m.k === 'sa' ? '32%' : m.k === 'ke' ? '8.2%' : '27.8%'}</b><span>OTT revenue as a share of traditional TV revenue by 2030</span><small>{src('ott_ratio')}</small></div>
                    <div class="fact"><b>US${m.k === 'sa' ? 76 : m.k === 'ke' ? 54 : 42}</b><span>average OTT revenue per subscription in 2030, against more than US$100 globally</span><small>{src('arpu')}</small></div>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <div class="grid3">
          <div class="card"><p class="card__k">South Africa · ad-funded streaming</p><b class="card__n">22.4% a year</b><p>AVOD, streaming paid for by adverts, is the fastest-growing OTT stream: US$19m in 2025 to US$52m in 2030, rising from about 5% to over 10% of OTT revenue.</p><small>{src('avod')}</small></div>
          <div class="card"><p class="card__k">South Africa · room to grow</p><b class="card__n">0.30 vs 0.86</b><p>OTT subscriptions per household in 2030, against the global level. Subscriptions slip from 6.0m to 5.8m, yet revenue still grows.</p><small>{src('ott_per_hh')}</small></div>
          <div class="card"><p class="card__k">South Africa · the big screen</p><b class="card__n">56.8%</b><p>of households will have a smart TV by 2030 (52.4% in 2025), well ahead of the 38.8% global average.</p><small>{src('smart_tv')}</small></div>
        </div>

        <h3 class="h3 sub">Gaming: the smartphone is the console</h3>
        <div class="grid2">
          <ChartFrame title="Video games revenue, 2025 and 2030" explain="All three markets grow faster than the global games market (3.6% a year). Esports revenue is negligible in all three." unit="US$ millions" period="2025 → 2030 (forecast)" source={src('games_three', 'global_games')} note={F.sa_games.note}>
            <Bars label="Video games revenue" suffix="" max={720} items={[
              { label: 'South Africa 2025', value: 564, display: '$564m', tone: 'peer' }, { label: 'South Africa 2030', value: 694, display: '$694m', status: 'forecast' },
              { label: 'Nigeria 2025', value: 286, display: '$286m', tone: 'peer' }, { label: 'Nigeria 2030', value: 430, display: '$430m', status: 'forecast' },
              { label: 'Kenya 2025', value: 101, display: '$101m', tone: 'peer' }, { label: 'Kenya 2030', value: 133, display: '$133m', status: 'forecast' },
            ]} />
          </ChartFrame>
          <div class="facts">
            <div class="fact"><b>8.5%</b><span>a year: Nigeria’s games growth, the strongest of the three. Gaming takes a much larger share of Nigeria’s E&amp;M market than in South Africa or Kenya.</span><small>{src('ng_gaming', 'games_three')}</small></div>
            <div class="fact"><b>77%</b><span>of Nigeria’s gaming revenue came from social and casual games in 2025</span><small>{src('ng_casual')}</small></div>
            <div class="fact"><b>In-app ads</b><span>grow faster than app-based consumer spending in all three markets, though spending stays the bigger stream</span><small>{src('inapp')}</small></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 06 LIVE -->
    <section class="sec theme-dark" id="live" aria-labelledby="lv-t" data-rp-section>
      <div class="wrap">
        <header class="sec__head"><span class="sec__n" aria-hidden="true">{num('live')}</span><div><p class="eyebrow">The enduring value of shared experiences</p><h2 id="lv-t">Screens are not replacing the room. They are filling it.</h2>
          <p class="lede">Streaming, social media and short video now work as discovery channels for live music, cinema and events, before, during and after the moment itself.</p></div></header>
        <div class="grid2">
          <ChartFrame title="Cinema revenue, 2025 and 2030" explain="Small in absolute terms, but growing in every market. Nigeria nearly triples." unit="US$ millions" period="2025 → 2030 (forecast)" source={src('cinema3')}>
            <Bars label="Cinema revenue" suffix="" max={60} items={[
              { label: 'South Africa 2025', value: 42, display: '$42m', tone: 'peer' }, { label: 'South Africa 2030', value: 59, display: '$59m', status: 'forecast' },
              { label: 'Nigeria 2025', value: 10, display: '$10m', tone: 'peer' }, { label: 'Nigeria 2030', value: 29, display: '$29m', status: 'forecast', tip: 'Nigeria cinema: $10m to $29m, 22.8% a year' },
              { label: 'Kenya 2025', value: 5, display: '$5m', tone: 'peer' }, { label: 'Kenya 2030', value: 8, display: '$8m', status: 'forecast' },
            ]} />
          </ChartFrame>
          <ChartFrame title="Music, radio and podcasts, 2025 and 2030" explain="Audio is an entry point into live events, sponsorship and creator communities." unit="US$ millions" period="2025 → 2030 (forecast)" source={`${srcT('sa')}, ${C.ke.page}, ${C.ng.page}`}>
            <Bars label="Music, radio and podcasts revenue" suffix="" max={600} items={markets.flatMap((m) => [
              { label: `${m.name} 2025`, value: v25(m.k, 'Music, radio & podcasts'), display: fmtM(v25(m.k, 'Music, radio & podcasts')), tone: 'peer' as const },
              { label: `${m.name} 2030`, value: v30(m.k, 'Music, radio & podcasts'), display: fmtM(v30(m.k, 'Music, radio & podcasts')), status: 'forecast' as const },
            ])} />
          </ChartFrame>
        </div>
        <div class="grid3">
          <div class="card"><p class="card__k">Nollywood</p><b class="card__n">Almost 50%</b><p>of Nigeria’s box office in 2025 came from local films, a milestone for the industry.</p><small>{src('nollywood')}</small></div>
          <div class="card"><p class="card__k">South Africa · local sound</p><b class="card__n">7 in 10</b><p>of the ten most-streamed artists in 2025 were South African.</p><small>{src('sa_local70')}</small></div>
          <div class="card"><p class="card__k">South Africa · live music</p><b class="card__n">5.7% vs 2.1%</b><p>a year to 2030, against the global rate, as shown in the report’s callout.</p><small>{src('live_music')}. {F.live_music.note}</small></div>
        </div>
        <p class="pull">“Live experiences offer what screens cannot fully replicate: presence, participation and a shared sense of belonging.” <small>p. 26</small></p>
      </div>
    </section>

    <!-- 07 NEXT -->
    <section class="sec theme-charcoal" id="next" aria-labelledby="nx-t" data-rp-section>
      <div class="wrap">
        <header class="sec__head"><span class="sec__n" aria-hidden="true">{num('next')}</span><div><p class="eyebrow">The next phase of value creation</p><h2 id="nx-t">Whoever owns the audience relationship wins.</h2>
          <p class="lede">Technology makes content cheaper to create, but distribution stays concentrated on a few platforms. PwC’s advice: build assets you control.</p></div></header>
        <div class="tabs" data-tabs>
          <div class="tabs__list" role="tablist" aria-label="Themes">
            <button type="button" role="tab" id="t-own" aria-controls="p-own" data-tab="own">Own the audience</button>
            <button type="button" role="tab" id="t-ai" aria-controls="p-ai" data-tab="ai">AI and African stories</button>
            <button type="button" role="tab" id="t-trust" aria-controls="p-trust" data-tab="trust">Trust</button>
          </div>
          <div role="tabpanel" id="p-own" aria-labelledby="t-own" data-panel="own" class="panel">
            <div class="assets">
              {['Intellectual property', 'Trusted brands', 'Direct customer relationships', 'First-party data', 'Multiple routes to market'].map((a, i) => <div class="asset"><span>{String(i + 1).padStart(2, '0')}</span><b>{a}</b></div>)}
            </div>
            <p class="srcline">The assets PwC says media businesses and creators should build ({src('audience_owner')}).</p>
          </div>
          <div role="tabpanel" id="p-ai" aria-labelledby="t-ai" data-panel="ai" class="panel">
            <div class="panel__grid">
              <div class="means"><p class="means__k">Where AI helps</p><p>Translation, subtitling and localisation, audience segmentation, campaign optimisation and production workflows. These matter more in Africa, where many languages and fragmented audiences make content harder to discover and distribute. The question is not how much content AI can make, but whether it makes content more relevant, more discoverable and more valuable.</p></div>
              <div class="facts"><div class="fact"><b>US$255bn</b><span>cumulative data centre investment projected across Africa through 2050, widening the room for digital and AI services</span><small>{src('datacentre')}, citing PwC’s Global Data Centre Outlook</small></div></div>
            </div>
          </div>
          <div role="tabpanel" id="p-trust" aria-labelledby="t-trust" data-panel="trust" class="panel">
            <ul class="chips">{['Copyright', 'Licensing', 'Attribution', 'Source verification', 'Misinformation', 'Privacy', 'Bias', 'Brand safety'].map((c) => <li>{c}</li>)}</ul>
            <p class="lead-in">All of these need clear accountability and human oversight. In PwC’s words, responsible governance “is not separate from the commercial opportunity; it is a fundamental part of it” (p. 28).</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 08 TAKEAWAYS -->
    <section class="sec theme-dark" id="takeaways" aria-labelledby="tk-t" data-rp-section>
      <div class="wrap">
        <header class="sec__head"><span class="sec__n" aria-hidden="true">{num('takeaways')}</span><div><p class="eyebrow">Key takeaways</p><h2 id="tk-t">Not traditional versus digital. Convergence.</h2></div></header>
        <div class="tk">
          <div>
            <p class="tag-wb">What PwC finds</p>
            <ol class="tk__list">
              <li>Connectivity is the largest revenue pool and the base for digital growth: 60–75% of E&amp;M revenue in 2030.</li>
              <li>Internet advertising grows in all three markets, fastest in Kenya (14.0% a year), driven by formats that can prove results.</li>
              <li>Streaming grows everywhere; only in South Africa does traditional TV shrink, and it is still more than three times OTT’s size in 2030.</li>
              <li>Gaming grows faster than the global games market in all three markets, powered by mobile.</li>
              <li>Live music, cinema and shared experiences keep growing as digital channels amplify them.</li>
            </ol>
            <p class="srcline">{src('conn_share', 'ke_ads_fastest', 'sa_tv_3x', 'games_three', 'convergence')}</p>
          </div>
          <div>
            <p class="tag-nm">Native Media perspective</p>
            <p class="muted tk__intro">Our reading of what the report means for different readers. This is editorial interpretation, not PwC analysis. Every fact it rests on is from the report.</p>
            <div class="persp">
              <details class="rec"><summary>Media owners and broadcasters</summary><p>In South Africa the fight is for share, not audience: TV falls 3.7% a year while OTT and ad-funded streaming grow. In Kenya and Nigeria TV is still growing, so there is time to build streaming and digital revenue alongside it, not instead of it. Direct relationships and first-party data are the assets to build.</p></details>
              <details class="rec"><summary>Brands and advertisers</summary><p>Budgets are moving to formats that can show outcomes: video in Kenya, retail search in Nigeria, connected TV in South Africa. That raises the bar for measurement. Be clear on what each channel delivers before the money follows the growth rates.</p></details>
              <details class="rec"><summary>Creators, artists and filmmakers</summary><p>Local content is winning at home: about half of Nigeria’s box office and seven of South Africa’s ten most-streamed artists. With distribution concentrated on a few platforms, owning your IP and audience matters as much as reach. AI localisation could help stories travel across languages.</p></details>
              <details class="rec"><summary>Telcos and policymakers</summary><p>Connectivity is most of the market and the gateway to the rest. The report’s point that quality and affordability, not just coverage, decide engagement makes affordable, reliable data the lever for the whole creative economy.</p></details>
            </div>
            <p class="srcline">{src('sa_tv_decline', 'ke_video_ads', 'nollywood', 'sa_local70', 'audience_owner', 'video_data')}</p>
          </div>
        </div>
      </div>
    </section>

