---
import BaseLayout from '../layouts/BaseLayout.astro';
import Visual from '../components/Visual.astro';
import ClientLogos from '../components/ClientLogos.astro';
import { Image } from 'astro:assets';
import { caseStudies } from '../data/caseStudies';
import HeroTexture from '../components/HeroTexture.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import Cover from '../components/Cover.astro';
import { aiPlatforms, company, pillars } from '../data/site';
import { episodeUrl, formatDate, getEpisodes, getGuest } from '../lib/episodes';

const latestEp = (await getEpisodes())[0]; // undefined until the first episode exists
const latestGuest = latestEp ? await getGuest(latestEp) : undefined;
const disciplines = ['Narrative engineering', 'Research & publications', 'African Intelligence', 'Creative data', 'Training & mentorship'];

const relationships = ['Institutional partners', 'Research collaborators', 'Production collaborators', 'Sponsors'];

---

<BaseLayout
  overHero
  title="Native Media | Insight. Strategy. Impact."
  description="Native Media is a Pan-African media-tech and strategic communication agency based in Dar es Salaam turning African intelligence into strategy and influence."
>
  <!-- 1. HERO -->
  <section class="hero theme-dark" aria-labelledby="hero-title">
    <HeroTexture />
    <div class="hero__shade" aria-hidden="true"></div>
    <div class="wrap hero__inner">
      <p class="eyebrow">Narrative · Research · Creative data</p>
      <h1 id="hero-title" class="hero__title">Turning African Intelligence into <em>strategy</em> and influence.</h1>
      <p class="lede hero__lede">{company.descriptor} We bring research, storytelling and creative production together to help organizations and audiences understand Africa and its opportunities.</p>
      <div class="hero__cta">
        <a class="btn" href="/what-we-do">Explore what we do <span aria-hidden="true">→</span></a>
        <a class="btn btn--ghost" href="/african-intelligence">Listen to African Intelligence</a>
      </div>
    </div>
    <p class="wrap hero__foot"><span class="hero__slogan">Insight. Strategy. Impact.</span></p>
  </section>

  <!-- 2. CORPORATE INTRODUCTION -->
  <section class="section theme-light" aria-labelledby="intro-title">
    <div class="wrap intro">
      <div class="reveal">
        <p class="eyebrow">Who we are</p>
        <h2 id="intro-title" class="display intro__title">One integrated approach to insight, narrative and communication.</h2>
      </div>
      <div class="intro__body reveal">
        <p class="lede">{company.positioning}</p>
        <p>Native Media does not treat these as separate services. Research informs the story, the story shapes the strategy, and creative production gives each of them reach. That shared approach is what makes the company distinct.</p>
        <ul class="chips" aria-label="Disciplines we bring together">
          {disciplines.map((d) => <li>{d}</li>)}
        </ul>
        <blockquote class="why">
          <p>“{company.why}”</p>
          <footer>Our WHY</footer>
        </blockquote>
        <a class="arrow-link" href="/about">About Native Media <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- CLIENTS -->
  <ClientLogos />

  <!-- 3. CAPABILITIES -->
  <section class="section theme-dark" id="capabilities" aria-labelledby="cap-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">What we do</p>
        <h2 id="cap-title">Five areas of work.</h2>
        <p class="lede">Each area stands on its own and strengthens the others.</p>
      </div>
      <ul class="pillars">
        {pillars.map((p) => (
          <li class="pillar reveal">
            <a href={p.href} class="pillar__link">
              <Visual art={p.art} label="Visual placeholder" ratio="16 / 9" />
              <div class="pillar__body">
                <span class="pillar__n">{p.n}</span>
                <h3>{p.title}</h3>
                <p>{p.summary}</p>
                <span class="arrow-link">Explore <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section class="section theme-dark" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Selected work</p>
        <h2 id="work-title">Narrative engineering in practice.</h2>
        <p class="lede">Media coordination, stakeholder linkage and narrative strategy for national development, energy transition and banking communications.</p>
      </div>
      <ul class="work">
        {caseStudies.map((x) => (
          <li class="work__item reveal">
            <a href={`/case-studies/${x.slug}`} class="work__img" tabindex="-1" aria-hidden="true"><Image src={x.cover} alt="" widths={[480, 720]} sizes="(min-width: 900px) 20rem, 92vw" /></a>
            <p class="eyebrow">{x.sector}</p>
            <h3><a href={`/case-studies/${x.slug}`}>{x.title}</a></h3>
          </li>
        ))}
      </ul>
      <p class="more"><a class="arrow-link" href="/case-studies">All case studies <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- 4. RESEARCH & PUBLICATIONS -->
  <section class="section theme-light" aria-labelledby="intel-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Research &amp; Publications</p>
        <h2 id="intel-title">Reports and research from leading organizations.</h2>
        <p class="lede">We curate reports and research from other organizations, always credited and linked to the original, so people and institutions can understand Africa from the best available evidence.</p>
      </div>
      <ul class="cards">
        <li class="card reveal"><h3><a href="/research-and-publications/reports">Reports</a></h3><p>Reports from institutions, agencies and organizations on Africa’s economies, societies and communication landscape.</p><a class="arrow-link" href="/research-and-publications/reports">Browse reports <span aria-hidden="true">→</span></a></li>
        <li class="card reveal"><h3><a href="/research-and-publications/research-papers">Research papers</a></h3><p>Papers by universities, think tanks and independent researchers, each linked to its original source.</p><a class="arrow-link" href="/research-and-publications/research-papers">Browse research papers <span aria-hidden="true">→</span></a></li>
      </ul>
      <p class="more"><a class="arrow-link" href="/research-and-publications">Explore Research &amp; Publications <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- 6. AFRICAN INTELLIGENCE -->
  <section class="section theme-dark ai" aria-labelledby="ai-title">
    <div class="wrap ai__grid">
      <div class="ai__copy reveal">
        <p class="eyebrow">Flagship content brand</p>
        <h2 id="ai-title" class="display">African Intelligence</h2>
        <p class="lede">Conversations on African business, economics, leadership, strategy, diplomacy, innovation and development: the ideas shaping the continent.</p>
        <ul class="platforms" aria-label="Where to listen">
          {aiPlatforms.map((p) => <li>{p.href ? <a class="tag tag--brand tag--link" href={p.href} rel="noopener" target="_blank">{p.label} <span class="sr-only">(opens in a new tab)</span></a> : <span class="tag">{p.label} · link pending</span>}</li>)}
        </ul>
        <p class="muted small">Available on YouTube, RSS.com, Spotify, Apple Podcasts and Amazon Music.</p>
        <div class="ai__cta">
          <a class="btn" href="/african-intelligence/latest-episodes">Browse episodes <span aria-hidden="true">→</span></a>
          <a class="btn btn--ghost" href="/african-intelligence/guests">Guests</a>
        </div>
      </div>
      {latestEp && latestGuest && <div class="ai__player reveal">
        <a class="ai__cover" href={episodeUrl(latestEp)}>
          <Cover cover={latestEp.data.cover} alt={latestEp.data.coverAlt} widths={[400, 640, 800]} sizes="(min-width: 900px) 34rem, 92vw" loading="lazy" />
        </a>
        <div class="ai__meta">
          <span class="tag tag--brand">Latest episode · Episode {latestEp.data.number}</span>
          <h3 class="ai__title"><a href={episodeUrl(latestEp)}>{latestEp.data.title}</a></h3>
          <p class="muted">{formatDate(latestEp.data.publishDate)} · With {latestGuest.data.name}, {latestGuest.data.organization}</p>
          <a class="arrow-link" href={episodeUrl(latestEp)}>Episode details <span aria-hidden="true">→</span></a>
        </div>
      </div>}
    </div>
  </section>

  <!-- 10. TRAINING & MENTORSHIP -->
  <section class="section theme-light" aria-labelledby="tm-title">
    <div class="wrap">
      <div class="section-head reveal">
        <p class="eyebrow">Training &amp; Mentorship</p>
        <h2 id="tm-title">Growing the next generation of African communicators.</h2>
        <p class="lede">Two focuses: developing thought leaders in communication, and Native Talks, a mentorship programme for young communicators.</p>
      </div>
      <ul class="cards">
        <li class="card reveal"><h3>Thought leadership development</h3><p>Nurturing thought leaders in the area of communication.</p><span class="tag">Details to be added</span></li>
        <li class="card reveal"><h3>Native Talks</h3><p>A young communication mentorship programme.</p><span class="tag">Details to be added</span></li>
      </ul>
      <p class="more"><a class="arrow-link" href="/training-and-mentorship">Explore Training &amp; Mentorship <span aria-hidden="true">→</span></a></p>
    </div>
  </section>

  <!-- 10. INSTITUTIONAL ENGAGEMENT -->
  <section class="section theme-light" aria-labelledby="inst-title">
    <div class="wrap inst">
      <div class="reveal">
        <p class="eyebrow">Institutional engagement</p>
        <h2 id="inst-title" class="display">Working with institutions, businesses and professional communities.</h2>
      </div>
      <div class="reveal">
        <p class="lede">Native Media collaborates on research, communications, publishing and production. Only confirmed relationships, shown with approved names and logos, will be listed.</p>
        <ul class="rel" aria-label="Relationship categories">
          {relationships.map((r) => (<li><span>{r}</span><span class="tag">None listed yet</span></li>))}
        </ul>
        <a class="btn" href="/contact/institutional-partnerships">Start a conversation <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 11. CORPORATE CTA -->
  <section class="section theme-charcoal cta" aria-labelledby="cta-title">
    <div class="wrap cta__inner reveal">
      <h2 id="cta-title" class="display">Let’s shape the next <em>African narrative.</em></h2>
      <div>
        <p class="lede">From strategic communications and intelligence to storytelling and creative production, Native Media works with organizations seeking to communicate with clarity, insight and impact.</p>
        <a class="btn" href="/contact">Make an inquiry <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- 12. NEWSLETTER -->
  <section class="section theme-light" id="newsletter" aria-labelledby="news-title">
    <div class="wrap news">
      <div class="reveal">
        <p class="eyebrow">Newsletter</p>
        <h2 id="news-title" class="display">Follow what Native Media publishes.</h2>
        <p class="lede">Choose the streams you want to hear about. We ask only for your email address.</p>
      </div>
      <div class="reveal"><NewsletterForm id="nlhome" /></div>
    </div>
  </section>
</BaseLayout>


<style>
  .work { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.8rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); } .work__item { display: grid; gap: 0.6rem; align-content: start; } .work__img { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #111; } .work__img :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease); } .work__item:hover .work__img :global(img) { transform: scale(1.04); } .work__item h3 { font-size: var(--step-1); font-weight: 800; line-height: 1.15; } .work__item h3 a { text-decoration: none; } .work__item h3 a:hover { color: var(--brand); }
  /* HERO */
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; padding: calc(var(--header-h) + 3rem) 0 2rem; overflow: hidden; isolation: isolate; }
  .hero :global(.hero__art) { position: absolute; inset: 0; z-index: -2; border-radius: 0; height: 100%; }
  .hero :global(.hero__art .visual__tag) { display: none; }
  .hero__shade { position: absolute; inset: 0; z-index: -1; background: radial-gradient(55rem 34rem at 88% 12%, rgba(237, 125, 62, 0.16), transparent 62%), linear-gradient(to top, #0a0a0a 0%, transparent 30%); }
  .hero__inner { display: grid; gap: 1.6rem; padding-bottom: 3rem; }
  .hero__title { font-weight: 800; font-size: var(--step-5); max-width: 17ch; letter-spacing: -0.035em; }
  .hero__title em { font-style: normal; color: var(--brand); }
  .hero__lede { color: var(--paper); opacity: 0.82; max-width: 38rem; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 0.9rem; margin-top: 0.6rem; }
  .hero__foot { border-top: 1px solid var(--line-dark); padding-top: 1.1rem; display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .hero__slogan { font-family: var(--font-display); font-weight: 700; font-size: var(--step--1); letter-spacing: 0.3em; text-transform: uppercase; color: var(--gray); }

  /* INTRO */
  .intro { display: grid; gap: 3rem; }
  .intro__title { font-size: var(--step-4); max-width: 16ch; margin-top: 1.2rem; }
  .intro__body { display: grid; gap: 1.5rem; align-content: start; }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li { font-family: var(--font-display); font-weight: 600; font-size: 0.85rem; padding: 0.45rem 0.9rem; border: 1px solid var(--line-light); border-radius: 999px; }
  .chips--dark li { border-color: var(--line-dark); }
  .why { margin: 0.5rem 0; padding-left: 1.5rem; border-left: 4px solid var(--brand); }
  .why p { font-family: var(--font-display); font-weight: 800; font-size: var(--step-2); line-height: 1.15; letter-spacing: -0.02em; }
  .why footer { margin-top: 0.7rem; font-size: var(--step--1); letter-spacing: 0.14em; text-transform: uppercase; color: var(--gray-ink); }

  /* PILLARS */
  @media (min-width: 1000px) { .pillars { grid-template-columns: repeat(6, 1fr) !important; } .pillar { grid-column: span 2; } .pillar:nth-child(n + 4) { grid-column: span 3; } }
  .pillars { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr)); }
  .pillar { background: var(--charcoal); border: 1px solid var(--line-dark); transition: border-color 0.3s var(--ease), transform 0.3s var(--ease); }
  .pillar:hover { border-color: var(--brand); transform: translateY(-4px); }
  .pillar__link { display: grid; height: 100%; grid-template-rows: auto 1fr; text-decoration: none; }
  .pillar__body { padding: 1.5rem 1.5rem 1.75rem; display: grid; gap: 0.8rem; align-content: start; position: relative; }
  .pillar__n { font-family: var(--font-display); font-weight: 800; color: var(--brand); font-size: 0.85rem; letter-spacing: 0.14em; }
  .pillar h3 { font-size: var(--step-2); font-weight: 800; }
  .pillar p { color: var(--gray); font-size: 0.97rem; }
  .pillar .arrow-link { margin-top: 0.4rem; }

  /* INTEL */
  .intel { display: grid; gap: 2rem; }
  .intel__slots { display: grid; gap: 1rem; }
  .slot > .tag { justify-self: start; }
  .slot { background: var(--white); border: 1px solid var(--line-light); padding: 1.6rem; display: grid; gap: 0.7rem; align-content: start; border-left: 4px solid var(--brand); }
  .slot h3 { font-size: var(--step-2); font-weight: 800; }
  .slot--lead { border-left-color: var(--black); background: var(--black); color: var(--paper); } .slot--lead h3 a { text-decoration: none; } .slot--lead h3 a:hover { color: var(--brand); } .slot--lead .slot__meta { color: var(--gray); border-top-color: var(--line-dark); } .slot--lead .arrow-link, .slot--lead .tag--brand { color: var(--brand); } .slot--lead .muted { color: var(--gray); }
  .slot__meta { font-size: 0.85rem; color: var(--gray-ink); border-top: 1px dashed var(--line-light); padding-top: 0.8rem; }
  .labels { background: var(--black); color: var(--paper); padding: 1.8rem; display: grid; gap: 1.1rem; align-content: start; }
  .labels h3 { font-size: var(--step-1); font-weight: 800; }
  .labels dt { font-family: var(--font-display); font-weight: 700; color: var(--brand); font-size: 0.82rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .labels dd { margin: 0.15rem 0 0.9rem; color: var(--gray); font-size: 0.93rem; }
  .labels .arrow-link { color: var(--brand); }

  /* STORIES */
  .stories { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr)); }
  .story { position: relative; min-height: 22rem; display: grid; }
  .story :global(.visual) { position: absolute; inset: 0; height: 100%; aspect-ratio: auto !important; }
  .story::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(10, 10, 10, 0.92), rgba(10, 10, 10, 0.1) 60%); pointer-events: none; }
  .story__text { position: relative; z-index: 1; align-self: end; padding: 1.4rem; display: grid; gap: 0.5rem; }
  .story__text p { font-family: var(--font-display); font-weight: 700; font-size: var(--step-1); line-height: 1.2; }
  .story :global(.visual__tag) { top: 0.75rem; bottom: auto; z-index: 2; }
  .more { margin-top: 2.5rem; }

  /* AFRICAN INTELLIGENCE */
  .ai { background: radial-gradient(60rem 30rem at 85% 0%, rgba(237, 125, 62, 0.16), transparent 60%), var(--black); border-top: 1px solid var(--line-dark); }
  .ai__grid { display: grid; gap: 3rem; align-items: center; }
  .ai__copy { display: grid; gap: 1.4rem; }
  .platforms { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .small { font-size: 0.85rem; }
  .tag--link { text-decoration: none; padding: 0.5rem 0.8rem; } .tag--link:hover { background: var(--brand); color: var(--black); }
  .ai__cta { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 0.4rem; }
  .ai__player { display: grid; gap: 1rem; }
  .ai__cover { display: block; border: 1px solid var(--line-dark); box-shadow: 12px 12px 0 var(--brand); max-width: 32rem; width: 100%; justify-self: start; margin-bottom: 0.8rem; }
  .ai__cover :global(img) { width: 100%; height: auto; display: block; }
  .ai__title { font-size: var(--step-2); font-weight: 800; } .ai__title a { text-decoration: none; } .ai__title a:hover { color: var(--brand); }
  .ai__meta { display: grid; gap: 0.5rem; justify-items: start; }

  /* PRODUCTIONS */
  .prods { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .prods li { display: grid; gap: 0.5rem; align-content: start; }
  .prods li :global(.visual) { margin-bottom: 0.6rem; }
  .prods__kind { font-family: var(--font-display); font-weight: 800; font-size: var(--step-1); }

  /* PUBLICATION */
  .pub { display: grid; gap: 3rem; align-items: center; }
  .cover { position: relative; margin: 0 auto 2.6rem; width: min(100%, 22rem); aspect-ratio: 3 / 4; background: linear-gradient(160deg, #262626, #0a0a0a); color: var(--paper); padding: 2rem; display: flex; flex-direction: column; justify-content: space-between; box-shadow: 0 30px 60px rgba(10, 10, 10, 0.35), 14px 14px 0 var(--brand); }
  .cover__n { width: 55%; fill: none; stroke: var(--brand); stroke-width: 3; }
  .cover__text span { display: block; font-family: var(--font-display); font-weight: 700; font-size: 0.72rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--gray); margin-bottom: 0.6rem; }
  .cover__text strong { font-family: var(--font-display); font-weight: 800; font-size: 1.7rem; line-height: 1; letter-spacing: -0.02em; text-transform: uppercase; }
  .cover__tag { position: absolute; left: 0; bottom: -2.6rem; }
  .pub__copy { display: grid; gap: 1.4rem; }
  .status { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .parts { display: grid; gap: 1.5rem; }
  .parts h3 { font-size: 1rem; font-weight: 800; margin-bottom: 0.6rem; }
  .parts div > h3:not(:first-child) { margin-top: 1.2rem; }
  .chapters { counter-reset: ch; display: grid; gap: 0.35rem; }
  .chapters li { counter-increment: ch; font-size: 0.95rem; display: flex; gap: 0.7rem; }
  .chapters li::before { content: counter(ch); font-family: var(--font-display); font-weight: 800; color: var(--brand-ink); min-width: 1rem; }
  .notice { font-size: 0.88rem; color: var(--gray-ink); border-left: 3px solid var(--line-light); padding-left: 1rem; }
  .pub__cta { display: flex; flex-wrap: wrap; gap: 0.8rem; }

  /* DATA */
  .data { display: grid; gap: 3rem; align-items: center; }
  .data .reveal:first-child { display: grid; gap: 1.4rem; }
  .small-h { font-size: 0.8rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gray); font-weight: 700; }
  .chart { margin: 0; background: var(--charcoal); border: 1px solid var(--line-dark); padding: 1.5rem; display: grid; gap: 1.2rem; }
  .chart__meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr)); gap: 0.8rem 1.5rem; margin: 0; }
  .chart__meta dt { font-size: 0.7rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gray); font-weight: 700; }
  .chart__meta dd { margin: 0.1rem 0 0; font-size: 0.9rem; }

  /* INSTITUTIONAL */
  .inst { display: grid; gap: 2.5rem; }
  .inst h2 { font-size: var(--step-3); max-width: 18ch; margin-top: 1.2rem; }
  .inst .reveal + .reveal { display: grid; gap: 1.5rem; align-content: start; justify-items: start; }
  .inst .rel { justify-self: stretch; width: 100%; }
  .rel li { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line-light); font-family: var(--font-display); font-weight: 600; }

  /* CTA */
  .cta { background: radial-gradient(50rem 24rem at 10% 100%, rgba(237, 125, 62, 0.18), transparent 60%), var(--charcoal); }
  .cta__inner { display: grid; gap: 2rem; align-items: center; }
  .cta h2 { font-size: var(--step-5); letter-spacing: -0.035em; }
  .cta em { font-style: normal; color: var(--brand); }
  .cta .lede { color: var(--paper); opacity: 0.8; margin-bottom: 1.6rem; }

  /* NEWSLETTER */
  .news { display: grid; gap: 3rem; }
  .news .reveal:first-child { display: grid; gap: 1.2rem; align-content: start; }
  .form { display: grid; gap: 1.4rem; background: var(--white); border: 1px solid var(--line-light); padding: clamp(1.4rem, 3vw, 2.2rem); }
  .preview-note { justify-self: start; }
  .field { display: grid; gap: 0.4rem; font-weight: 600; }
  .field input { padding: 0.85rem 1rem; border: 1.5px solid var(--black); border-radius: var(--radius); background: var(--paper); color: var(--black); }
  fieldset { border: 0; padding: 0; margin: 0; }
  legend { font-weight: 600; margin-bottom: 0.7rem; padding: 0; }
  .checks { display: grid; gap: 0.6rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .check { display: flex; gap: 0.7rem; align-items: flex-start; font-size: 0.95rem; cursor: pointer; }
  .check input { width: 1.15rem; height: 1.15rem; margin-top: 0.2rem; accent-color: var(--brand); flex: none; }
  .consent { font-size: 0.85rem; color: var(--gray-ink); }
