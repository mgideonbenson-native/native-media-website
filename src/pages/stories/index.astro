---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import DemoBanner from '../../components/DemoBanner.astro';
import StoryCard from '../../components/StoryCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import { storyCategories, storyKinds } from '../../data/categories';
const stories = await getCollection('stories');
const featured = stories.find((s) => s.data.featured) ?? stories[0];
const rest = stories.filter((s) => s.id !== featured.id);
const allDemo = stories.every((s) => s.data.demo);
---
<BaseLayout title="Stories | Native Media" description="African stories, told with context: business, economics, history, geopolitics, technology, infrastructure and society." noindex={allDemo}>
  <PageHero eyebrow="Stories" title="African stories, told with context." lede="Original reporting, research-based analysis, interviews and multimedia, curated for depth rather than speed."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Stories' }]} />
  {allDemo && <DemoBanner text="The stories below are layout demonstrations. Real stories will replace them, and none of this content is real." />}
  <section class="section theme-charcoal">
    <div class="wrap">
      <div class="feat"><StoryCard story={featured} big /></div>
      <div class="filters">
        <label for="q" class="sr-only">Search stories</label>
        <input id="q" type="search" placeholder="Search stories" autocomplete="off" />
        <div class="chips" role="group" aria-label="Filter by category">
          <button type="button" class="chip" aria-pressed="true" data-cat="">All</button>
          {storyCategories.map((c) => <button type="button" class="chip" aria-pressed="false" data-cat={c.slug}>{c.label}</button>)}
        </div>
        <p class="count" role="status" aria-live="polite" data-count></p>
      </div>
      <div class="grid" data-list>{rest.map((s) => <StoryCard story={s} />)}</div>
      <p class="muted" data-none hidden>No stories match your search.</p>
    </div>
  </section>
  <section class="section theme-light">
    <div class="wrap split">
      <div class="stack"><p class="eyebrow">How we label stories</p><h2 class="h2">You always know what you are reading.</h2></div>
      <dl class="kinds">{Object.values(storyKinds).map((k) => <><dt>{k.label}</dt><dd>{k.text}</dd></>)}</dl>
    </div>
  </section>
  <CtaBand />
</BaseLayout>
<style>
  .feat { margin-bottom: 4rem; } .feat :global(.scard--big) { grid-template-columns: 1fr; }
  .filters { display: grid; gap: 1rem; margin-bottom: 2.5rem; }
  input[type='search'] { width: 100%; max-width: 30rem; padding: 0.9rem 1rem; border: 1.5px solid var(--line-dark); background: var(--black); color: var(--paper); border-radius: var(--radius); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chip { cursor: pointer; background: none; border: 1px solid var(--line-dark); color: var(--paper); padding: 0.45rem 0.9rem; border-radius: 999px; font-family: var(--font-display); font-weight: 600; font-size: 0.85rem; }
  .chip[aria-pressed='true'] { background: var(--brand); border-color: var(--brand); color: var(--black); }
  .count { font-size: 0.88rem; color: var(--gray); }
  .grid { display: grid; gap: 2.2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr)); }
  .kinds dt { font-family: var(--font-display); font-weight: 800; margin-top: 1rem; } .kinds dd { margin: 0.2rem 0 0; color: var(--gray-ink); padding-bottom: 1rem; border-bottom: 1px solid var(--line-light); }
  @media (min-width: 900px) { .feat :global(.scard--big) { grid-template-columns: 1.3fr 1fr; align-items: center; gap: 3rem; } }
</style>
<script>
  const q = document.querySelector<HTMLInputElement>('#q')!;
  const cards = [...document.querySelectorAll<HTMLElement>('[data-list] > article')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const none = document.querySelector<HTMLElement>('[data-none]')!;
  let cat = '';
  const apply = () => {
    const t = q.value.trim().toLowerCase(); let n = 0;
    cards.forEach((c) => { c.hidden = !((!cat || c.dataset.cat === cat) && (!t || (c.dataset.search ?? '').includes(t))); if (!c.hidden) n++; });
    chips.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.cat ?? '') === cat)));
    count.textContent = `${n} stor${n === 1 ? 'y' : 'ies'} shown`; none.hidden = n > 0;
  };
  q.addEventListener('input', apply);
  chips.forEach((b) => b.addEventListener('click', () => { cat = b.dataset.cat ?? ''; apply(); }));
  apply();
</script>
