  .cards .card { padding: 1.6rem; display: grid; gap: 0.6rem; align-content: start; } .cards h3 a { text-decoration: none; } .cards h3 a:hover { color: var(--brand-ink); } .small { font-size: 0.88rem; }
  @media (prefers-reduced-motion: reduce) { :global(.js) .dots__pair.go .dotgrid li, .hbars__t i, :global(.vbars__t i), :global(.cmp__track i), :global(.js) .stage { transition: none; } }
  @media print { .story__stage { position: static; } :global(.js) .stage { opacity: 1; visibility: visible; } .story__steps li { min-height: 0; opacity: 1; } }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;


  // 0. The dots light up one by one when they scroll into view.
  const dots = document.querySelector<HTMLElement>('[data-dots]');
  if (dots) {
    if (reduce || !('IntersectionObserver' in window)) dots.classList.add('go');
    else { const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { dots.classList.add('go'); io.disconnect(); } }), { threshold: 0.35 }); io.observe(dots); }
  }

  // 1. Numbers count up when they scroll into view.
  document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
    const to = Number(el.dataset.to), dec = Number(el.dataset.dec || 0);
    if (reduce || !('IntersectionObserver' in window)) return;
    el.textContent = (0).toFixed(dec);
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return; io.disconnect();
      const t0 = performance.now(), dur = 1200;
      const tick = (t: number) => { const p = Math.min(1, (t - t0) / dur), v = to * (1 - Math.pow(1 - p, 3)); el.textContent = v.toFixed(dec); if (p < 1) requestAnimationFrame(tick); };
      requestAnimationFrame(tick);
    }), { threshold: 0.4 });
    io.observe(el);
  });

  // 2. Scroll story: the chart changes as each step scrolls into view.
  const story = document.querySelector<HTMLElement>('[data-story]');
  if (story && 'IntersectionObserver' in window) {
    const stages = [...story.querySelectorAll<HTMLElement>('[data-stage]')];
    const texts = [...story.querySelectorAll<HTMLElement>('[data-step-text]')];
    const show = (n: string) => {
      story.dataset.step = n;
      stages.forEach((s) => { const on = s.dataset.stage === n; s.classList.toggle('on', on); s.setAttribute('aria-hidden', String(!on)); });
      texts.forEach((t) => t.classList.toggle('on', t.dataset.stepText === n));
    };
    show('1');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) show((e.target as HTMLElement).dataset.stepText!); }), { rootMargin: '-45% 0px -45% 0px' });
    texts.forEach((t) => io.observe(t));
  }

  // 3. Explore and 4. Compare use the numbers embedded in the page.
  type C = Record<string, number | string>;
  const raw = document.getElementById('snap-data');
  if (raw) {
    const { countries, metrics, compareRows } = JSON.parse(raw.textContent || '{}') as { countries: C[]; metrics: { key: string; label: string; unit: string; text: string; higher: string }[]; compareRows: { key: string; label: string; unit: string }[] };
    const byName = (n: string) => countries.find((c) => c.name === n)!;

    const explore = document.querySelector<HTMLElement>('[data-explore]');
    if (explore) {
      const list = explore.querySelector<HTMLElement>('[data-bars]')!;
      const what = explore.querySelector<HTMLElement>('[data-metric-text]')!;
      const chips = [...explore.querySelectorAll<HTMLButtonElement>('[data-metric]')];
      let metric = metrics[0].key, selected = 'Kenya';
      const detail = () => {
        const c = byName(selected);
        explore.querySelector('[data-d-name]')!.textContent = selected;
        explore.querySelectorAll<HTMLElement>('[data-fact]').forEach((d) => {
          const row = compareRows.find((r) => r.key === d.dataset.fact)!; d.textContent = `${c[row.key]}${row.unit}`;
        });
      };
      const svg = explore.querySelector<SVGSVGElement>('[data-map]');
      const dar = svg?.querySelector('.map__dar') ?? null;
      const paintMap = (m: { key: string; unit: string; label: string }) => {
        if (!svg) return;
        const vals = countries.map((c) => Number(c[m.key])); const lo = Math.min(...vals), hi = Math.max(...vals);
        const a = [243, 227, 214], z = [176, 79, 18];
        svg.querySelectorAll<SVGPathElement>('path[data-country]').forEach((pa) => {
          const c = byName(pa.dataset.country!); const t = hi === lo ? 0 : (Number(c[m.key]) - lo) / (hi - lo);
          pa.style.fill = `rgb(${a.map((v, i) => Math.round(v + (z[i] - v) * t)).join(',')})`;
          const ti = pa.querySelector('title'); if (ti) ti.textContent = `${c.name}: ${c[m.key]}${m.unit} (${m.label})`;
          pa.classList.toggle('sel', c.name === selected);
          if (c.name === selected && dar) svg.insertBefore(pa, dar);
        });
      };
      const draw = () => {
        const m = metrics.find((x) => x.key === metric)!;
        paintMap(m);
        const sorted = [...countries].sort((a, b) => Number(b[metric]) - Number(a[metric]));
        list.replaceChildren(...sorted.map((c) => {
          const li = document.createElement('li'); const b = document.createElement('button'); b.type = 'button'; b.className = 'vbars__row'; b.dataset.country = String(c.name);
          if (c.name === selected) b.setAttribute('aria-current', 'true');
          const l = document.createElement('span'); l.className = 'vbars__l'; l.textContent = String(c.name);
          const t = document.createElement('span'); t.className = 'vbars__t'; const i = document.createElement('i'); i.style.setProperty('--w', `${Number(c[metric])}%`); t.append(i);
          const v = document.createElement('span'); v.className = 'vbars__v'; v.textContent = `${c[metric]}${m.unit}`;
          b.append(l, t, v); li.append(b); return li;
        }));
        what.textContent = `${m.text} ${m.higher}`;
        chips.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.metric === metric)));
      };
      chips.forEach((x) => x.addEventListener('click', () => { metric = x.dataset.metric!; draw(); }));
      svg?.addEventListener('click', (e) => { const pa = (e.target as Element).closest<SVGPathElement>('path[data-country]'); if (!pa) return; selected = pa.dataset.country!; draw(); detail(); });
      list.addEventListener('click', (e) => { const b = (e.target as HTMLElement).closest<HTMLElement>('[data-country]'); if (!b) return; selected = b.dataset.country!; draw(); detail(); (list.querySelector(`[data-country="${selected}"]`) as HTMLElement | null)?.focus(); });
      draw(); detail();
    }

    const cmp = document.querySelector<HTMLElement>('[data-compare]');
    if (cmp) {
      const out = cmp.querySelector<HTMLElement>('[data-compare-out]')!;
      const picks = [...cmp.querySelectorAll<HTMLSelectElement>('[data-pick]')];
      const maxHalving = Math.max(...countries.map((c) => Number(c.halving)));
      const el = (tag: string, cls?: string, text?: string) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text) e.textContent = text; return e; };
      const render = () => {
        const [a, b] = picks.map((p) => byName(p.value));
        const wrap = el('div', 'cmp');
        const head = el('div', 'cmp__head'); head.append(el('span', '', String(a.name)), el('span', '', String(b.name))); wrap.append(head);
        compareRows.forEach((r) => {
          const row = el('div', 'cmp__row'); row.append(el('span', 'cmp__label', r.label));
          const bars = el('div', 'cmp__bars');
          [a, b].forEach((c, idx) => {
            const side = el('div', idx ? 'cmp__side cmp__side--b' : 'cmp__side');
            const tr = el('span', 'cmp__track'); const i = document.createElement('i'); const pct = r.key === 'halving' ? (Number(c[r.key]) / maxHalving) * 100 : Number(c[r.key]); i.style.setProperty('--w', `${pct}%`); tr.append(i);
            side.append(tr, el('span', 'cmp__val', `${c[r.key]}${r.unit}`)); bars.append(side);
          });
          row.append(bars); wrap.append(row);
        });
        out.replaceChildren(wrap);
      };
      picks.forEach((p) => p.addEventListener('change', render));
      render();
    }
  }
</script>
