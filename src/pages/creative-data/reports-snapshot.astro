---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { geoMercator, geoPath } from 'd3-geo';
import { feature } from 'topojson-client';
import topo from 'world-atlas/countries-50m.json';
import { reports, countries, metrics, compareRows, wbFacts, groups, outOf100, pov, povApproved } from '../../data/snapshot';
const fmt = (n: number) => n.toLocaleString('en-US');
const data = JSON.stringify({ countries, metrics, compareRows });
const show = (k: keyof typeof pov) => (povApproved ? pov[k] : '');

// Africa map, computed at build time from public-domain outlines (Natural Earth via world-atlas).
const africa = ['Algeria','Angola','Benin','Botswana','Burkina Faso','Burundi','Cameroon','Central African Rep.','Chad','Congo','Dem. Rep. Congo','Côte d\'Ivoire','Djibouti','Egypt','Eq. Guinea','Eritrea','eSwatini','Ethiopia','Gabon','Gambia','Ghana','Guinea','Guinea-Bissau','Kenya','Lesotho','Liberia','Libya','Madagascar','Malawi','Mali','Mauritania','Morocco','Mozambique','Namibia','Niger','Nigeria','Rwanda','Senegal','Sierra Leone','Somalia','Somaliland','South Africa','S. Sudan','Sudan','Tanzania','Togo','Tunisia','Uganda','W. Sahara','Zambia','Zimbabwe'];
const atlasName: Record<string, string> = { DRC: 'Dem. Rep. Congo' };
const feats = ((feature(topo as any, (topo as any).objects.countries) as any).features as any[]).filter((f) => africa.includes(f.properties.name));
const proj = geoMercator().fitSize([600, 640], { type: 'FeatureCollection', features: feats } as any);
const path = geoPath(proj).digits(1);
const reportNames = new Map(countries.map((c) => [atlasName[c.name] ?? c.name, c.name]));
const mapPaths = feats.map((f) => ({ id: f.properties.name as string, short: reportNames.get(f.properties.name) ?? null, d: path(f) as string, tz: f.properties.name === 'Tanzania' }));
const dar = proj([39.28, -6.79]) as [number, number];

// Scatter: phone price against usage gap, with a straight line of best fit (our own arithmetic on the report's numbers).
const xs = countries.map((c) => c.priceShare), ys = countries.map((c) => c.usageGap);
const mean = (a: number[]) => a.reduce((t, v) => t + v, 0) / a.length;
const mx = mean(xs), my = mean(ys);
const slope = xs.reduce((t, v, i) => t + (v - mx) * (ys[i] - my), 0) / xs.reduce((t, v) => t + (v - mx) ** 2, 0);
const icpt = my - slope * mx;
const r = xs.reduce((t, v, i) => t + (v - mx) * (ys[i] - my), 0) / Math.sqrt(xs.reduce((t, v) => t + (v - mx) ** 2, 0) * ys.reduce((t, v) => t + (v - my) ** 2, 0));
const SW = 640, SH = 420, L = 56, R = 24, T = 20, B = 52;
const X = (v: number) => L + (v / 100) * (SW - L - R);
const Y = (v: number) => SH - B - ((v - 30) / 50) * (SH - T - B);
const lab: Record<string, [number, number, string]> = { Ghana: [0, -12, 'middle'], Kenya: [-10, -9, 'end'], Egypt: [-6, 30, 'end'], Nigeria: [11, -6, 'start'], Senegal: [12, 14, 'start'], 'South Africa': [11, 4, 'start'], Uganda: [11, 4, 'start'], DRC: [11, 4, 'start'], Ethiopia: [-11, 4, 'end'], Niger: [11, 14, 'start'], Rwanda: [-11, 18, 'end'] };
---
<BaseLayout title="Reports in focus: an interactive snapshot | Native Media" description="An interactive snapshot of two reports featured by Native Media: connecting 1 billion Africans by 2030 (PDAA and GSMA Intelligence) and the World Bank’s Africa Economic Update on AI readiness.">
  <PageHero eyebrow="Creative Data · Interactive" title="Reports in focus."
    lede="An interactive snapshot of two reports featured on Native Media: how Africa can connect 1 billion people by 2030, and how ready the continent is for artificial intelligence."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Creative Data', href: '/creative-data' }, { label: 'Reports in focus' }]}>
    <a class="btn" href="#story">Start the story <span aria-hidden="true">↓</span></a>
    <a class="btn btn--ghost" href="#explore">Jump to the data</a>
  </PageHero>

  <section class="section theme-charcoal dots" aria-labelledby="dots-t">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Out of every 100 people</p><h2 id="dots-t">Who is online?</h2>
        <p class="lede">Each dot is one person out of 100. Lit dots used the internet in 2025.</p></div>
      <div class="dots__pair" data-dots>
        <figure class="dots__fig">
          <ol class="dotgrid" aria-hidden="true">{Array.from({ length: 100 }, (_, i) => <li class={i < outOf100.africa ? 'on' : ''} style={`--i:${i}`}></li>)}</ol>
          <figcaption><strong>{outOf100.africa} out of 100</strong><span>in Africa used the internet in 2025</span></figcaption>
        </figure>
        <figure class="dots__fig">
          <ol class="dotgrid dotgrid--world" aria-hidden="true">{Array.from({ length: 100 }, (_, i) => <li class={i < outOf100.world ? 'on' : ''} style={`--i:${i}`}></li>)}</ol>
          <figcaption><strong>{outOf100.world} out of 100</strong><span>worldwide</span></figcaption>
        </figure>
      </div>
      <p class="chart-note">Source: ITU data, quoted in the PDAA / GSMA Intelligence report (2025).</p>
      {show('dots') && <aside class="pov"><p class="pov__label">Native Media’s view</p><p>{show('dots')}</p></aside>}
    </div>
  </section>

  <section class="section theme-dark" id="gap" aria-labelledby="gap-t">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">The people behind the percentages</p><h2 id="gap-t">Africa’s 1.5 billion, in one picture.</h2>
        <p class="lede">The report splits Africa’s population into three groups. The biggest is not the one most people expect.</p></div>
      <figure class="onebar" data-onebar>
        <div class="onebar__bar" role="img" aria-label={groups.map((g) => `${g.million} million: ${g.label}`).join('; ')}>
          {groups.map((g) => <span class={`seg seg--${g.key}`} style={`--w:${g.million}`}><b>{g.million}M</b></span>)}
        </div>
        <ul class="onebar__legend">
          {groups.map((g) => <li class={`seg-key seg-key--${g.key}`}><strong>{g.million} million</strong><span>{g.label}</span></li>)}
        </ul>
        <figcaption class="chart-note">Source: PDAA / GSMA Intelligence, 2025. “Mobile internet users” is the report’s own count of people using the mobile internet (517 million); the three groups add up to roughly 1.5 billion. The widths are drawn to scale.</figcaption>
      </figure>
      {show('gap') && <aside class="pov"><p class="pov__label">Native Media’s view</p><p>{show('gap')}</p></aside>}
    </div>
  </section>

  <section class="section theme-dark story" id="story" aria-labelledby="s-t">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">The story in four steps</p><h2 id="s-t">From coverage to meaningful use.</h2></div>
      <div class="story__grid" data-story data-step="1">
        <div class="story__stage" aria-hidden="false">
          <figure class="stage" data-stage="1">
            <figcaption class="stage__title">Mobile broadband gaps, Africa<span>PDAA / GSMA Intelligence · % of population</span></figcaption>
            <ul class="hbars">
              <li><span class="hbars__l">Coverage gap, 2015</span><span class="hbars__t"><i style="--w:41%"></i></span><span class="hbars__v">41%</span></li>
              <li><span class="hbars__l">Coverage gap, 2025</span><span class="hbars__t"><i style="--w:8%"></i></span><span class="hbars__v">8%</span></li>
              <li><span class="hbars__l">Usage gap, 2025</span><span class="hbars__t"><i class="hot" style="--w:60%"></i></span><span class="hbars__v">almost 60%</span></li>
            </ul>
          </figure>
          <figure class="stage" data-stage="2">
            <figcaption class="stage__title">Internet users in Africa<span>PDAA / GSMA Intelligence · millions of people</span></figcaption>
            <ul class="hbars">
              <li><span class="hbars__l">2025</span><span class="hbars__t"><i style="--w:55%"></i></span><span class="hbars__v">550</span></li>
              <li><span class="hbars__l">2030, current path</span><span class="hbars__t"><i style="--w:70%"></i></span><span class="hbars__v">about 700</span></li>
              <li><span class="hbars__l">2030 ambition</span><span class="hbars__t"><i class="hot" style="--w:100%"></i></span><span class="hbars__v">1,000</span></li>
            </ul>
            <p class="stage__note">A shortfall of more than 300 million against the ambition.</p>
          </figure>
          <figure class="stage" data-stage="3">
            <figcaption class="stage__title">If both gaps were halved<span>PDAA / GSMA Intelligence · acceleration scenario, not a forecast</span></figcaption>
            <ul class="hbars">
              <li><span class="hbars__l">Mobile internet users, 2025</span><span class="hbars__t"><i style="--w:51.7%"></i></span><span class="hbars__v">517 million</span></li>
              <li><span class="hbars__l">Added by halving both gaps</span><span class="hbars__t"><i class="hot" style="--w:51.4%"></i></span><span class="hbars__v">+514 million</span></li>
            </ul>
            <p class="stage__note">Together: more than 1 billion, the report’s ambition. Coverage gap: 122 million people. Usage gap: 906 million people.</p>
          </figure>
          <figure class="stage" data-stage="4">
            <figcaption class="stage__title">Africa and AI readiness<span>World Bank · % of the world or of Africa</span></figcaption>
            <ul class="hbars">
              <li><span class="hbars__l">Share of world population</span><span class="hbars__t"><i style="--w:18%"></i></span><span class="hbars__v">{wbFacts.popShare}%</span></li>
              <li><span class="hbars__l">Share of global data-centre capacity</span><span class="hbars__t"><i class="hot" style="--w:3%"></i></span><span class="hbars__v">{wbFacts.dataCentreShare}%</span></li>
              <li><span class="hbars__l">African data centres that are AI-ready</span><span class="hbars__t"><i style="--w:5%"></i></span><span class="hbars__v">about {wbFacts.aiReadyDataCentres}%</span></li>
              <li><span class="hbars__l">Share of global AI training data from Africa</span><span class="hbars__t"><i style="--w:2%"></i></span><span class="hbars__v">about {wbFacts.aiTrainingData}%</span></li>
            </ul>
          </figure>
        </div>
        <ol class="story__steps">
          <li data-step-text="1"><h3>Networks have mostly arrived.</h3><p>Africa’s mobile broadband coverage gap fell from 41% in 2015 to 8% in 2025. The bigger gap now is use: almost 60% of people live within coverage but do not use the mobile internet. <cite>PDAA / GSMA Intelligence</cite></p></li>
          <li data-step-text="2"><h3>The current path falls short.</h3><p>Africa had 550 million internet users in 2025, or 36% of the population, against 74% worldwide. At the current pace it reaches about 700 million by 2030, more than 300 million short of the 1 billion ambition. <cite>PDAA / GSMA Intelligence</cite></p></li>
          <li data-step-text="3"><h3>The gap is closable.</h3><p>Halving the coverage and usage gaps could bring about 514 million more people online. The report calls this an acceleration scenario rather than a forecast, and says it depends on affordable devices, infrastructure, energy, skills, relevant services and trust. <cite>PDAA / GSMA Intelligence</cite></p></li>
          <li data-step-text="4"><h3>And the next gap is AI.</h3><p>Africa holds 18% of the world’s people but just 0.6% of global data-centre capacity, and only about 2% of global AI training data comes from the continent. About 900 million Africans remain offline. <cite>World Bank</cite></p></li>
        </ol>
      </div>
    </div>
  </section>

  <section class="section theme-light" id="explore" aria-labelledby="e-t">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Explore the data</p><h2 id="e-t">Eleven countries, one shared challenge.</h2>
        <p class="lede">The PDAA / GSMA Intelligence report assessed 11 countries. Choose a measure to rank them, then select a country for its full profile.</p></div>
      <div class="explore" data-explore>
        <div class="explore__main">
          <div class="chips" role="group" aria-label="Choose a measure" data-metrics>
            {metrics.map((m, i) => <button type="button" class="chip" aria-pressed={i === 0 ? 'true' : 'false'} data-metric={m.key}>{m.label}</button>)}
          </div>
          <p class="explore__what" data-metric-text aria-live="polite">{metrics[0].text} {metrics[0].higher}</p>
          <div class="explore__viz">
          <figure class="map" aria-hidden="true">
            <svg viewBox="0 0 600 640" role="presentation" focusable="false" data-map>
              {mapPaths.map((m) => m.short
                ? <path class="c in" d={m.d} data-country={m.short}><title>{m.short}</title></path>
                : <path class={m.tz ? 'c tz' : 'c'} d={m.d} />)}
              <g class="map__dar" transform={`translate(${dar[0]} ${dar[1]})`}><circle r="4" /><text x="9" y="4">Dar es Salaam</text></g>
            </svg>
            <figcaption class="map__legend"><span>Lower</span><i></i><span>Higher</span><span class="map__none">Not in the report</span></figcaption>
          </figure>
          <ul class="vbars" data-bars>
            {[...countries].sort((a, b) => b.usageGap - a.usageGap).map((c) => (
              <li><button type="button" data-country={c.name} class="vbars__row"><span class="vbars__l">{c.name}</span><span class="vbars__t"><i style={`--w:${c.usageGap}%`}></i></span><span class="vbars__v">{c.usageGap}%</span></button></li>
            ))}
          </ul>
          </div>
          <p class="chart-note">Source: GSMA Intelligence, World Bank, as published in the PDAA / GSMA Intelligence report. Reporting year 2025; electricity access 2024. Percentages of each country’s population. The map repeats the ranked list for people who prefer to see where countries are; keyboard and screen-reader users can use the list. Tanzania was not one of the 11 countries assessed.</p>
          {show('map') && <aside class="pov pov--light"><p class="pov__label">Native Media’s view</p><p>{show('map')}</p></aside>}
        </div>
        <aside class="explore__detail" aria-labelledby="d-t" data-detail>
          <h3 id="d-t" data-d-name>Kenya</h3>
          <dl class="facts" data-d-facts>
            {compareRows.map((r) => <div><dt>{r.label}</dt><dd data-fact={r.key}>{(countries.find((c) => c.name === 'Kenya') as any)[r.key]}{r.unit}</dd></div>)}
          </dl>
        </aside>
      </div>
      <details class="table-view">
        <summary>View all the numbers as a table</summary>
        <div class="table-wrap">
          <table>
            <caption>Eleven countries assessed in the PDAA / GSMA Intelligence report (percent of population unless stated)</caption>
            <thead><tr><th scope="col">Country</th><th scope="col">Mobile internet adoption</th><th scope="col">Usage gap</th><th scope="col">Coverage gap</th><th scope="col">Smartphone adoption</th><th scope="col">Phone price, % of monthly income</th><th scope="col">Rural population</th><th scope="col">Rural electricity access</th><th scope="col">Million people if gaps halved</th></tr></thead>
            <tbody>{countries.map((c) => <tr><th scope="row">{c.name}</th><td>{c.adoption}%</td><td>{c.usageGap}%</td><td>{c.coverageGap}%</td><td>{c.smartphone}%</td><td>{c.priceShare}%</td><td>{c.rural}%</td><td>{c.elecRural}%</td><td>{c.halving}</td></tr>)}</tbody>
          </table>
        </div>
      </details>
    </div>
  </section>

  <section class="section theme-dark" id="price" aria-labelledby="p-t">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">A pattern in the numbers</p><h2 id="p-t">Does the price of a phone explain who is offline?</h2>
        <p class="lede">Each dot is one of the 11 countries. The further right, the harder a basic phone is to afford. The higher up, the larger the share of covered people not using the mobile internet.</p></div>
      <figure class="scatter">
        <svg viewBox={`0 0 ${SW} ${SH}`} role="img" aria-labelledby="sc-t sc-d" focusable="false">
          <title id="sc-t">Scatter plot of entry-level phone price against the usage gap in 11 African countries</title>
          <desc id="sc-d">{countries.map((c) => `${c.name}: phone price ${c.priceShare}% of monthly income, usage gap ${c.usageGap}%`).join('. ')}.</desc>
          {[30, 40, 50, 60, 70, 80].map((v) => <g class="grid"><line x1={L} x2={SW - R} y1={Y(v)} y2={Y(v)} /><text x={L - 8} y={Y(v) + 4} text-anchor="end">{v}%</text></g>)}
          {[0, 20, 40, 60, 80, 100].map((v) => <g class="grid"><line x1={X(v)} x2={X(v)} y1={T} y2={SH - B} /><text x={X(v)} y={SH - B + 18} text-anchor="middle">{v}%</text></g>)}
          <line class="fit" x1={X(0)} y1={Y(icpt)} x2={X(100)} y2={Y(icpt + slope * 100)} />
          <text class="axis" x={(L + SW - R) / 2} y={SH - 8} text-anchor="middle">Entry-level smartphone price, as a share of average monthly income</text>
          <text class="axis" transform={`translate(14 ${(T + SH - B) / 2}) rotate(-90)`} text-anchor="middle">Usage gap</text>
          {countries.map((c) => { const [dx, dy, anchor] = lab[c.name] ?? [10, 4, 'start']; return (
            <g class="pt" tabindex="0" role="group" aria-label={`${c.name}: phone price ${c.priceShare}% of monthly income, usage gap ${c.usageGap}%`}>
              {c.name === 'Egypt' && <line class="leader" x1={X(c.priceShare)} y1={Y(c.usageGap) + 5} x2={X(c.priceShare) - 8} y2={Y(c.usageGap) + 20} />}<circle cx={X(c.priceShare)} cy={Y(c.usageGap)} r="7" /><text x={X(c.priceShare) + dx} y={Y(c.usageGap) + dy} text-anchor={anchor}>{c.name}</text>
            </g>); })}
        </svg>
        <figcaption class="chart-note">Source: GSMA Intelligence, as published in the PDAA / GSMA Intelligence report (2025). The dashed line is a straight line of best fit that Native Media drew through the 11 points; the correlation is {r.toFixed(2)} (1.00 would mean the two move in perfect step). Eleven countries is a small sample, and a pattern is not proof that one thing causes the other.</figcaption>
      </figure>
      {show('price') && <aside class="pov"><p class="pov__label">Native Media’s view</p><p>{show('price')}</p></aside>}
    </div>
  </section>

  <section class="section theme-charcoal" id="compare" aria-labelledby="c-t">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Compare</p><h2 id="c-t">Put two countries side by side.</h2></div>
      <div class="compare" data-compare>
        <div class="compare__pick">
          <label>First country<select data-pick="0">{countries.map((c) => <option value={c.name} selected={c.name === 'Kenya'}>{c.name}</option>)}</select></label>
          <label>Second country<select data-pick="1">{countries.map((c) => <option value={c.name} selected={c.name === 'Ethiopia'}>{c.name}</option>)}</select></label>
        </div>
        <div class="compare__out" data-compare-out aria-live="polite"></div>
        <noscript><p class="muted">Turn on JavaScript to compare countries, or use the table in the section above.</p></noscript>
      </div>
    </div>
  </section>

  <section class="section theme-light" aria-labelledby="tz-t">
    <div class="wrap split">
      <div class="stack">
        <p class="eyebrow">Close to home</p>
        <h2 class="h2" id="tz-t">Tanzania: connecting schools is the start.</h2>
        <p>One of the report’s case studies looks at Airtel SmartWasomi, a partnership between Airtel Tanzania, Unicef and the Ministry of Education. It combines school connectivity, learning platforms that can be used without data charges, and teacher training.</p>
        <p class="muted small">The report notes that the figures below are programme-wide across 13 African countries, not Tanzania-only results.</p>
      </div>
      <ul class="tz">
        <li><strong>3,296</strong><span>schools connected by 2025/2026</span></li>
        <li><strong>64</strong><span>education platforms zero-rated</span></li>
        <li><strong>38,800+</strong><span>teachers trained</span></li>
        <li><strong>2.1 million</strong><span>children with access to the internet or digital learning</span></li>
      </ul>
    </div>
  </section>

  <section class="section theme-light sources" aria-labelledby="src-t">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Sources</p><h2 id="src-t">Read the reports in full.</h2>
        <p class="lede">Every figure on this page comes from these two reports and is shown as they published it. Native Media has not changed, estimated or combined the numbers. Native Media is not the author of either report.</p></div>
      <ul class="cards">
        {Object.values(reports).map((r) => (
          <li class="card">
            <span class="eyebrow">Report · {r.year}</span>
            <h3><a href={r.url} target="_blank" rel="noopener noreferrer">{r.title}<span class="sr-only"> (opens the original in a new tab)</span></a></h3>
            <p class="muted small">Published by {r.by}</p>
            <a class="arrow-link" href={r.url} target="_blank" rel="noopener noreferrer" aria-hidden="true" tabindex="-1">Read the original <span aria-hidden="true">↗</span></a>
          </li>
        ))}
      </ul>
      <p class="muted small">See all featured reports in <a href="/research-and-publications/reports">Research &amp; Publications</a>.</p>
    </div>
  </section>

  {show('close') && (
    <section class="section theme-dark" aria-labelledby="pov-t"><div class="wrap">
      <div class="section-head"><p class="eyebrow">Native Media’s view</p><h2 id="pov-t">What it means.</h2></div>
      <p class="pov__big">{show('close')}</p>
    </div></section>
  )}

  <CtaBand title="Want your research to look like this?" text="We turn reports and datasets into interactive pieces people want to explore." href="/contact/creative-data" label="Creative Data inquiry" />

  <script type="application/json" id="snap-data" set:html={data}></script>
</BaseLayout>

<style>
  .stats { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .stat { padding: 1.4rem; border: 1px solid var(--line-dark); border-top: 3px solid var(--brand); display: grid; gap: 0.4rem; align-content: start; }
  .stat__src { font-family: var(--font-display); font-weight: 700; font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gray); }
  .stat__num { margin: 0; font-family: var(--font-display); font-weight: 800; font-size: var(--step-4); line-height: 1; color: var(--brand); }
  .stat__suffix { font-size: 0.5em; margin-left: 0.15em; color: var(--paper); }
  .stat__label { margin: 0; font-weight: 600; }
  .stat__note { margin: 0; font-size: 0.88rem; color: var(--gray); }

  .story__grid { display: grid; gap: 1.5rem; }
  .story__stage { position: sticky; top: calc(var(--header-h, 4.5rem) + 0.5rem); z-index: 2; background: var(--black); border: 1px solid var(--line-dark); padding: 1.2rem; min-height: 16rem; display: grid; }
  .stage { grid-area: 1 / 1; margin: 0; display: grid; gap: 1rem; align-content: start; }
  :global(.js) .stage { opacity: 0; visibility: hidden; transition: opacity 0.4s var(--ease), visibility 0.4s; }
  :global(.js) [data-step='1'] .stage[data-stage='1'], :global(.js) [data-step='2'] .stage[data-stage='2'], :global(.js) [data-step='3'] .stage[data-stage='3'], :global(.js) [data-step='4'] .stage[data-stage='4'] { opacity: 1; visibility: visible; }
  :global(html:not(.js)) .story__stage { position: static; }
  .stage__title { font-family: var(--font-display); font-weight: 800; font-size: var(--step-1); display: grid; gap: 0.2rem; }
  .stage__title span { font-weight: 500; font-size: 0.82rem; color: var(--gray); font-family: var(--font-body, inherit); }
  .stage__note { margin: 0; font-size: 0.9rem; color: var(--gray); }
