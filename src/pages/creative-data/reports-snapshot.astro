  .pov p { margin: 0; } .pov p:last-child { font-size: var(--step-1); line-height: 1.45; }
  .pov__label { font-family: var(--font-display); font-weight: 700; font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand); }
  .theme-light .pov__label { color: #8a3a0a; }
  .pov__big { font-size: var(--step-2); line-height: 1.35; font-weight: 600; max-width: 42rem; margin: 0; }

  .tz { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(2, 1fr); align-content: start; }
  .tz li { background: var(--white); border: 1px solid var(--line-light); border-top: 3px solid var(--brand); padding: 1rem; display: grid; gap: 0.2rem; }
  .tz strong { font-family: var(--font-display); font-weight: 800; font-size: var(--step-3); }
