---
import DataPage from '../../../components/DataPage.astro';
import Explorer from '../../../components/Explorer.astro';
---
<DataPage title="Economic diplomacy data hub" lede="Explore indicators by partner, region, sector, year and investment category. This prototype uses illustrative sample data.">
  <section class="section theme-light"><div class="wrap stack">
    <Explorer id="hub" />
    <p class="muted small">Every chart on this site shows its title, indicator, reporting period, source, units and notes. Change a filter and the chart, table, CSV and notes all update together.</p>
  </div></section>
</DataPage>
<style>.small { font-size: 0.88rem; }</style>
