---
import DataPage from '../../../components/DataPage.astro';
import { datasetMeta, isSample } from '../../../data/sample';
const tools = [
  ['Economic diplomacy data hub', '/intelligence/data-and-visuals/data-hub', 'Filter by country, region, sector, year, indicator, partner and investment category. Chart, table and CSV update together.'],
  ['Bilateral trade', '/intelligence/data-and-visuals/bilateral-trade', 'Compare trade by partner, region or over time.'],
  ['Investment', '/intelligence/data-and-visuals/investment', 'Investment by sector, category, partner or year.'],
  ['Africa map', '/intelligence/data-and-visuals/africa-map', 'An interactive map ready for country-level indicators.'],
  ['Economic diplomacy timeline', '/intelligence/data-and-visuals/diplomacy-timeline', 'Visits, commissions, missions, agreements and summits in date order.'],
];
const every = ['Title', 'Indicator', 'Reporting period', 'Source', 'Units', 'Explanatory notes'];
---
<DataPage hub title="Information, made explorable." lede="Interactive charts, maps and data explainers built to be read, checked and reused. Everything here currently uses clearly labelled illustrative sample data.">
  <section class="section theme-light">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Tools</p><h2>Explore the prototypes.</h2></div>
      <ul class="cards">{tools.map(([t, h, d]) => <li class="card"><h3><a href={h}>{t}</a></h3><p>{d}</p><span class="tag">Sample data</span><a class="arrow-link" href={h}>Open <span aria-hidden="true">→</span></a></li>)}</ul>
    </div>
  </section>
  <section class="section theme-dark">
    <div class="wrap split">
      <div class="stack"><p class="eyebrow">Our standard</p><h2 class="h2">Every exhibit shows its working.</h2>
        <p class="muted">No figure appears without its source and period. Sample data is always marked, and is never used in published content.</p></div>
      <ul class="checklist">{every.map((e) => <li>{e}</li>)}</ul>
    </div>
  </section>
  <section class="section theme-light">
    <div class="wrap split">
      <div class="stack"><p class="eyebrow">Built for everyone</p><h2 class="h2">Legible, accessible, usable on a phone.</h2></div>
      <ul class="checklist" style="grid-template-columns:1fr">
        <li>Every chart has a data table and a CSV download.</li><li>Charts can be read with a keyboard (arrow keys on line charts, tab on bars and map countries).</li>
        <li>Colour is never the only signal: legends, labels and line styles repeat it.</li><li>Charts resize for narrow screens without losing detail.</li>
      </ul>
    </div>
  </section>
  <section class="section theme-charcoal">
    <div class="wrap split">
      <div class="stack"><p class="eyebrow">Datasets</p><h2 class="h2">Registered datasets.</h2></div>
      <div class="stack"><div class="notice-box"><span class="tag tag--brand">{isSample ? 'Sample' : 'Verified'}</span>
        <p><strong>{datasetMeta.title}</strong>: {datasetMeta.rows} rows. {datasetMeta.units}. {datasetMeta.period}.</p><p class="muted small">Source: {datasetMeta.source}</p></div>
        <p class="muted small">No verified dataset has been loaded yet. When one is approved, it is added with its source, units, period and notes, and replaces the sample.</p></div>
    </div>
  </section>
</DataPage>
<style>.card h3 a { text-decoration: none; } .card h3 a:hover { color: var(--brand); } .card .tag { justify-self: start; } .small { font-size: 0.88rem; }</style>
