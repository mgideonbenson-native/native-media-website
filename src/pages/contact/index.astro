---
import ContactPage from '../../components/ContactPage.astro';
import { contactTopics } from '../../data/site';
const routes = [
  ['General inquiries', '/contact/general-inquiries', 'Questions about Native Media.'],
  ['Narrative Engineering', '/contact/narrative-engineering', 'Strategic narratives, positioning and communication strategy.'],
  ['Research collaboration', '/contact/research-collaboration', 'Research, publications and third-party research.'],
  ['Creative Data', '/contact/creative-data', 'Audiovisuals, motion graphics, digital videos and visual research presentations.'],
  ['Training & Mentorship', '/contact/training-and-mentorship', 'Thought leadership development and Native Talks.'],
  ['Institutional partnerships', '/contact/institutional-partnerships', 'Partnerships, sponsorship and institutional work.'],
];
---
<ContactPage title="Contact Native Media" topic="General inquiry" crumb={false}
  lede="Tell us what you are working on. Choose the inquiry type that fits best, or use the general form and we will direct it to the right person."
  points={['Your name, organization and role', 'What you would like to achieve', 'Any timeline or format you have in mind', `Inquiry types: ${contactTopics.join(', ')}`]}>
  <p class="muted" style="margin-top:.5rem">Or go straight to a specific form:</p>
  <ul class="routes">{routes.map(([t, h, d]) => <li><a href={h}><strong>{t}</strong><span>{d}</span></a></li>)}</ul>
</ContactPage>
<style>
  .routes { display: grid; gap: 0.6rem; }
  .routes a { display: grid; gap: 0.15rem; padding: 0.9rem 1.1rem; border: 1px solid var(--line-light); text-decoration: none; background: var(--white); border-left: 4px solid var(--brand); }
  .routes a:hover { border-color: var(--brand); }
  .routes strong { font-family: var(--font-display); }
  .routes span { font-size: 0.9rem; color: var(--gray-ink); }
</style>
