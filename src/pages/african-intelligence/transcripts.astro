---
import AiNav from '../../components/AiNav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { episodeUrl, formatDate, getEpisodes } from '../../lib/episodes';
const eps = await getEpisodes();
---
<BaseLayout title="Transcripts | African Intelligence" description="Transcripts of African Intelligence episodes, where available.">
  <PageHero eyebrow="African Intelligence" title="Transcripts" lede="Transcripts will be published here as they are prepared and approved."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'African Intelligence', href: '/african-intelligence' }, { label: 'Transcripts' }]} />
  <AiNav />
  <section class="section theme-light">
    <div class="wrap">
      <ul class="list">{eps.map((e) => <li><a href={episodeUrl(e)}><strong>Episode {e.data.number}: {e.data.title}</strong><span class="muted">{formatDate(e.data.publishDate)} · {e.data.transcript ? 'Transcript available' : 'Transcript not yet published'}</span></a></li>)}</ul>
    </div>
  </section>
</BaseLayout>
<style>.list a { display: grid; gap: 0.2rem; padding: 1.1rem 0; border-bottom: 1px solid var(--line-light); text-decoration: none; } .list a:hover strong { color: var(--brand-ink); }</style>
