---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import DemoBanner from '../../components/DemoBanner.astro';
import ProductionCard from '../../components/ProductionCard.astro';
import Visual from '../../components/Visual.astro';
import CtaBand from '../../components/CtaBand.astro';
import { productionCategories } from '../../data/categories';
const all = await getCollection('productions');
const feat = all.find((p) => p.data.featured) ?? all[0];
const allDemo = all.every((p) => p.data.demo);
---
<BaseLayout title="Productions | Native Media" description="Documentaries, corporate films, motion graphics and visual explainers from Native Media." noindex={allDemo}>
  <PageHero eyebrow="Productions" title="Cinematic work, made with purpose." lede="Documentaries, corporate films, visual explainers and motion graphics. Only completed, verified projects with confirmed credits appear in the portfolio."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Productions' }]} />
  {allDemo && <DemoBanner text="The productions below are layout demonstrations. No real projects, clients or credits are shown." />}
  <section class="section theme-charcoal">
    <div class="wrap">
      <a class="feat" href={`/productions/${feat.data.category}/${feat.id}`}>
        <Visual art={feat.data.art} label="Featured production placeholder" ratio="21 / 9" />
        <div class="feat__text"><span class="eyebrow">Featured production</span><h2>{feat.data.title}</h2><p class="muted">{feat.data.synopsis}</p></div>
      </a>
    </div>
  </section>
  <section class="section theme-dark">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow">Collections</p><h2>Browse by type.</h2></div>
      <ul class="cards">{productionCategories.map((c) => <li class="card"><h3><a href={`/productions/${c.slug}`}>{c.label}</a></h3><p>{c.blurb}</p></li>)}</ul>
      <p class="more"><a class="arrow-link" href="/productions/production-portfolio">View the full portfolio <span aria-hidden="true">→</span></a></p>
    </div>
  </section>
  <CtaBand title="Start a production." text="Documentary, corporate film, podcast or motion graphics: tell us what you have in mind." href="/contact/production-inquiries" label="Production inquiry" />
</BaseLayout>
<style>
  .feat { display: grid; gap: 1.5rem; text-decoration: none; } .feat:hover h2 { color: var(--brand); }
  .feat__text { display: grid; gap: 0.8rem; max-width: 44rem; } .feat h2 { font-size: var(--step-4); font-weight: 800; }
  .card h3 a { text-decoration: none; } .card h3 a:hover { color: var(--brand); } .more { margin-top: 2.5rem; }
</style>
