---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import DemoBanner from '../../../components/DemoBanner.astro';
import ProductionCard from '../../../components/ProductionCard.astro';
import { portfolioCategory, productionCategories } from '../../../data/categories';
export function getStaticPaths() { return [...productionCategories, portfolioCategory].map((c) => ({ params: { category: c.slug }, props: { cat: c } })); }
const { cat } = Astro.props;
const all = await getCollection('productions');
const items = cat.slug === 'production-portfolio' ? all : all.filter((p) => p.data.category === cat.slug);
const allDemo = items.every((p) => p.data.demo);
const isPortfolio = cat.slug === 'production-portfolio';
---
<BaseLayout title={`${cat.label} | Productions | Native Media`} description={cat.blurb} noindex={allDemo}>
  <PageHero eyebrow="Productions" title={cat.label} lede={cat.blurb} crumbs={[{ label: 'Home', href: '/' }, { label: 'Productions', href: '/productions' }, { label: cat.label }]} />
  {allDemo && items.length > 0 && <DemoBanner text="Demonstration content. Real productions are added only with confirmed projects, clients and credits." />}
  <section class="section theme-charcoal">
    <div class="wrap">
      {isPortfolio && (
        <div class="chips" role="group" aria-label="Filter by type">
          <button type="button" class="chip" aria-pressed="true" data-cat="">All</button>
          {productionCategories.map((c) => <button type="button" class="chip" aria-pressed="false" data-cat={c.slug}>{c.label}</button>)}
        </div>
      )}
      {items.length > 0 ? <div class="grid" data-list>{items.map((p) => <ProductionCard p={p} />)}</div> : <p class="muted">No productions have been published in this category yet.</p>}
    </div>
  </section>
</BaseLayout>
<style>
  .grid { display: grid; gap: 2.2rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 2.5rem; }
  .chip { cursor: pointer; background: none; border: 1px solid var(--line-dark); color: var(--paper); padding: 0.45rem 0.9rem; border-radius: 999px; font-family: var(--font-display); font-weight: 600; font-size: 0.85rem; }
  .chip[aria-pressed='true'] { background: var(--brand); border-color: var(--brand); color: var(--black); }
</style>
<script>
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-list] > article')];
  chips.forEach((b) => b.addEventListener('click', () => {
    const c = b.dataset.cat ?? '';
    cards.forEach((el) => (el.hidden = !!c && el.dataset.cat !== c));
    chips.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
  }));
</script>
