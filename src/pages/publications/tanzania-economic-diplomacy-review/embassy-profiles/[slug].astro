---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHero from '../../../../components/PageHero.astro';
import CtaBand from '../../../../components/CtaBand.astro';
import ReviewTabs from '../../../../components/ReviewTabs.astro';
import { REVIEW_BASE } from '../../../../data/review';
import { getProfiles } from '../../../../lib/review-cms';

export async function getStaticPaths() {
  return (await getProfiles()).map((p) => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
---
<BaseLayout title={`${p.country} | Partner profile | Tanzania Economic Diplomacy Review`} description={`${p.country}: partner profile in the Tanzania Economic Diplomacy Review. Verified and signed off by the mission.`}>
  <PageHero eyebrow={`Partner profile · ${p.region}`} title={p.country} lede="Compiled by Native Media from the sources listed below, and checked and signed off by the mission concerned."
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Publications', href: '/publications' }, { label: 'Tanzania Economic Diplomacy Review', href: REVIEW_BASE }, { label: 'Partner profiles', href: `${REVIEW_BASE}/embassy-profiles` }, { label: p.country }]}>
    <p class="flags"><span class="tag tag--brand">Verified</span>{p.signoffDate && <span class="tag">Signed off by the mission {p.signoffDate}</span>}{p.sponsored && <span class="tag tag--brand">Sponsored profile</span>}{p.cutoff && <span class="tag">Data cut-off {p.cutoff}</span>}</p>
  </PageHero>
  <ReviewTabs />
  <section class="section theme-light"><div class="wrap split">
    <aside class="stack">
      <h2 class="h2">At a glance</h2>
      <dl class="dl">
        {p.relationsStart && <><dt>Diplomatic relations since</dt><dd>{p.relationsStart}</dd></>}
        {p.ambassadorName && <><dt>Ambassador</dt><dd>{p.ambassadorName}{p.ambassadorTitle ? `, ${p.ambassadorTitle}` : ''}</dd></>}
        {p.missionAddress && <><dt>Mission address</dt><dd>{p.missionAddress}</dd></>}
      </dl>
      <p class="muted small">A Native Media publication. Not an official government publication. {p.sponsored ? 'This profile is sponsored; sponsorship does not determine its editorial content.' : ''}</p>
    </aside>
    <div class="stack prose">
      {p.sections.map((s) => <section><h2>{s.title}</h2><Fragment set:html={s.html} /></section>)}
      {p.sources.length > 0 && <section><h2>Sources</h2><ol class="src">{p.sources.map((x) => <li>{x}</li>)}</ol></section>}
    </div>
  </div></section>
  <CtaBand title="Report an error." text="Spotted something wrong? We correct it openly and keep the record." href={`${REVIEW_BASE}/corrections`} label="Corrections process" />
</BaseLayout>
<style>
  .flags { display: flex; flex-wrap: wrap; gap: 0.6rem; } .dl { display: grid; gap: 0.2rem; } .dl dt { font-weight: 700; margin-top: 0.8rem; } .dl dd { margin: 0; color: var(--gray-ink); } .small { font-size: 0.88rem; }
  .prose :global(h2) { font-family: var(--font-display); font-weight: 800; font-size: var(--step-2); margin: 1.4rem 0 0.6rem; } .prose :global(p) { max-width: 44rem; margin-bottom: 0.9rem; } .prose :global(ul) { list-style: disc; padding-left: 1.3rem; } .prose :global(a) { color: var(--brand-ink); }
  .src { padding-left: 1.2rem; list-style: decimal; display: grid; gap: 0.3rem; }
</style>
